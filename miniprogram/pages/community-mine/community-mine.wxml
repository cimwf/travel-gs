<unread-banner></unread-banner>
<view class="container">
  <scroll-view class="list-scroll" scroll-y enhanced show-scrollbar="{{false}}"
    refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh" bindscrolltolower="onLoadMore">

    <view class="status-wrap" wx:if="{{loading && posts.length === 0}}">
      <view class="spinner"></view>
      <text class="status-text">加载中...</text>
    </view>

    <view class="status-wrap" wx:elif="{{error && posts.length === 0}}">
      <text class="status-title">作品加载失败</text>
      <view class="retry-btn" bindtap="onRetry">重新加载</view>
    </view>

    <view class="status-wrap" wx:elif="{{!loading && !error && posts.length === 0}}">
      <text class="empty-icon">□</text>
      <text class="status-title">还没有作品</text>
      <text class="status-text">发布的旅行动态会显示在这里</text>
    </view>

    <view class="posts" wx:if="{{posts.length > 0}}">
      <view class="post-card" wx:for="{{posts}}" wx:key="_id">
        <view class="post-header">
          <view class="author">
            <image class="avatar" src="{{item.authorAvatar || '/images/logo.png'}}" mode="aspectFill"></image>
            <view class="author-meta">
              <view class="author-row">
                <text class="author-name">{{item.authorName || '旅行者'}}</text>
                <text class="status-badge status-{{item.statusClass}}">{{item.statusText}}</text>
              </view>
              <text class="post-time">{{item.timeText}}</text>
            </view>
          </view>
          <view class="more-btn" bindtap="onMoreTap" data-id="{{item._id}}">
            <image class="more-icon" src="/images/icon-more-gray.png" mode="aspectFit"></image>
          </view>
        </view>

        <view class="post-body" wx:if="{{item.content}}">
          <text class="post-text">{{item.content}}</text>
        </view>

        <view class="post-images {{item.imageLayout}}" wx:if="{{item.images && item.images.length > 0}}">
          <image wx:for="{{item.images}}" wx:for-item="img" wx:key="key"
            class="post-img {{item.imageLayout === 'grid-1' ? 'img-lg' : ''}}"
            src="{{img.url}}" mode="aspectFill"
            bindtap="onPreviewImage" data-urls="{{item.imageUrls}}" data-current="{{img.url}}">
          </image>
        </view>

        <view class="post-location" wx:if="{{item.hasLocation}}" bindtap="onOpenLocation"
          data-lat="{{item.location.latitude}}" data-lng="{{item.location.longitude}}"
          data-name="{{item.location.name}}" data-address="{{item.location.address}}">
          <image class="location-icon" src="/images/icon-location-blue.png" mode="aspectFit"></image>
          <text class="location-name">{{item.location.name}}</text>
        </view>

        <view class="review-tip" wx:if="{{item.reviewStatus === 'reviewing'}}">
          内容正在等待自动审核结果
        </view>
        <view class="review-tip pending-review-tip"
          wx:if="{{item.reviewStatus === 'approved' && item.adminReviewStatus === 'pending'}}">
          内容已发布，后续将进行人工复核
        </view>
        <view class="review-tip manual-review-tip" wx:if="{{item.reviewStatus === 'manual_review'}}">
          自动审核风险较高，暂不在社区展示，等待人工审核
        </view>
        <view class="review-tip rejected-tip" wx:if="{{item.reviewStatus === 'rejected'}}">
          内容未通过安全审核，不会展示在社区
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{hasMore && posts.length > 0 && !loading}}">上拉加载更多</view>
    <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">— 没有更多了 —</view>
  </scroll-view>
</view>
