/* pages/community-publish/community-publish.wxss */
page { --primary: #4A90E2; --text: #1A1A2E; --hint: #8E8EA0; --border: #E8E8F0; --bg: #F5F7FA; --err: #FF4D4F; }
page { background: #fff; }

.container { height: 100vh; display: flex; flex-direction: column; }

/* scroll */
.pub-scroll { flex: 1; height: 0; padding: 0 32rpx; box-sizing: border-box; }

/* author */
.author-row { display: flex; align-items: center; gap: 16rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--border); }
.author-avatar { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--border); }
.author-name { font-size: 28rpx; color: var(--text); font-weight: 500; }

/* text */
.text-wrap { padding: 24rpx 0; position: relative; }
.text-input { width: 100%; min-height: 260rpx; font-size: 30rpx; line-height: 1.7; color: var(--text); padding: 0; }
.char-count { text-align: right; font-size: 22rpx; color: var(--hint); padding-top: 8rpx; }

/* images */
.img-grid { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 8rpx 0 24rpx; }
.grid-item { width: calc((100% - 24rpx) / 3); height: 210rpx; border-radius: 12rpx; overflow: hidden; position: relative; background: var(--bg); }
.grid-img { width: 100%; height: 100%; }
.grid-overlay { position: absolute; top:0; left:0; right:0; bottom:0; display:flex; align-items:center; justify-content:center; }
.overlay-bg { position: absolute; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,.5); }
.overlay-text { position: relative; color: #fff; font-size: 22rpx; z-index: 1; }
.retry-btn { position: relative; z-index: 1; padding: 8rpx 20rpx; background: var(--primary); border-radius: 8rpx; }
.retry-text { color: #fff; font-size: 20rpx; }
.grid-delete { position: absolute; top: 4rpx; right: 4rpx; width: 40rpx; height: 40rpx; background: rgba(0,0,0,.6); border-radius: 50%; display: flex; align-items: center; justify-content: center; z-index: 2; }
.delete-icon { width: 20rpx; height: 20rpx; }
.grid-add { border: 2rpx dashed var(--border); display: flex; align-items: center; justify-content: center; }
.add-inner { display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.add-camera-icon { width: 64rpx; height: 64rpx; }
.add-count { font-size: 20rpx; color: var(--hint); }

/* error */
.upload-error { padding: 16rpx 0; }
.error-text { font-size: 24rpx; color: var(--err); }

/* progress */
.progress-wrap { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 0; }
.progress-bar { flex: 1; height: 8rpx; background: var(--border); border-radius: 4rpx; overflow: hidden; }
.progress-fill { height: 100%; background: var(--primary); border-radius: 4rpx; transition: width .3s; }
.progress-label { font-size: 22rpx; color: var(--hint); }

/* lightweight location chip */
.location-wrap { display: flex; padding: 4rpx 0 8rpx; }
.location-chip {
  max-width: 100%;
  min-height: 56rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 28rpx;
  background: #F2F7FF;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}
.location-chip:active { opacity: .72; }
.location-chip.selected { background: #EDF5FF; }
.location-icon { width: 28rpx; height: 28rpx; flex-shrink: 0; }
.location-label { font-size: 24rpx; color: var(--primary); white-space: nowrap; }
.location-value { max-width: 500rpx; font-size: 24rpx; color: #58708F; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.location-clear { width: 32rpx; height: 40rpx; display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0; }
.location-clear-icon { width: 20rpx; height: 20rpx; opacity: .72; }

/* bottom submit */
.bottom-submit {
  height: 88rpx;
  margin: 48rpx 0 calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(74, 144, 226, .22);
}
.bottom-submit:active { opacity: .9; }
.bottom-submit.disabled { opacity: .5; }
