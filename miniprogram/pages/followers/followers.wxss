page {
  min-height: 100%;
  background: #fff;
  color: #17202b;
}

.follow-page {
  min-height: 100vh;
  padding: 18rpx 0 calc(36rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-sizing: border-box;
}

.follow-tabs {
  height: 86rpx;
  display: flex;
  margin: 0 82rpx 30rpx;
  padding: 3rpx;
  border: 2rpx solid #cfe0f4;
  border-radius: 46rpx;
  background: rgba(255, 255, 255, .84);
  box-sizing: border-box;
}

.follow-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  color: #384152;
  font-size: 29rpx;
  line-height: 1;
}

.follow-tab-active {
  background: #1677ed;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 7rpx 18rpx rgba(22, 119, 237, .17);
}

.follow-list {
  padding: 0 44rpx;
  background: #fff;
}

.follow-row {
  min-height: 218rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e3e9f0;
}

.follow-row:last-child {
  border-bottom: 0;
}

.follow-avatar {
  width: 126rpx;
  height: 126rpx;
  flex: none;
  border-radius: 50%;
  background: #e2edf8;
}

.follow-copy {
  min-width: 0;
  flex: 1;
  margin-left: 26rpx;
}

.follow-name {
  display: block;
  overflow: hidden;
  color: #101722;
  font-size: 32rpx;
  font-weight: 650;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.follow-region {
  display: flex;
  align-items: center;
  margin-top: 9rpx;
  color: #738095;
  font-size: 24rpx;
}

.follow-region image {
  width: 28rpx;
  height: 28rpx;
  margin-right: 7rpx;
}

.follow-bio {
  display: block;
  max-width: 330rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: #7d8798;
  font-size: 24rpx;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.follow-button {
  width: 144rpx;
  height: 62rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 18rpx;
  border: 2rpx solid #b9c3d0;
  border-radius: 32rpx;
  color: #748095;
  font-size: 25rpx;
  box-sizing: border-box;
}

.follow-button-follow {
  border-color: #1677ed;
  color: #1677ed;
}

.follow-button-following {
  border-color: #b9c3d0;
  color: #748095;
}

.follow-button-mutual {
  border-color: #1677ed;
  color: #1677ed;
}

.follow-button:active {
  opacity: .66;
}

.follow-status {
  min-height: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 70rpx 64rpx;
  box-sizing: border-box;
  color: #8a95a6;
  font-size: 25rpx;
  text-align: center;
}

.follow-error-icon {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 24rpx;
}

.follow-status-empty {
  min-height: 0;
  justify-content: flex-start;
  padding-top: 380rpx;
}

.follow-empty-icon {
  width: 136rpx;
  height: 136rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  border-radius: 50%;
  background: #e8f2ff;
}

.follow-empty-icon image {
  width: 72rpx;
  height: 72rpx;
}

.follow-loading-dot {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 18rpx;
  border: 4rpx solid #dce8f5;
  border-top-color: #1677ed;
  border-radius: 50%;
  animation: follow-spin .8s linear infinite;
}

@keyframes follow-spin {
  to { transform: rotate(360deg); }
}

.follow-status-title {
  color: #17202b;
  font-size: 30rpx;
  font-weight: 600;
}

.follow-status-desc {
  max-width: 560rpx;
  margin-top: 24rpx;
  color: #8a95a6;
  font-size: 24rpx;
  line-height: 38rpx;
}

.follow-empty-action {
  min-width: 214rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 42rpx;
  padding: 0 34rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.follow-empty-action-primary {
  background: #1677ed;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 237, .16);
}

.follow-empty-action-outline {
  border: 2rpx solid #1677ed;
  background: transparent;
  color: #1677ed;
}

.follow-empty-action:active {
  opacity: .7;
}

.follow-retry {
  min-width: 204rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  border-radius: 38rpx;
  background: #1677ed;
  color: #fff;
  font-size: 26rpx;
}

.follow-more {
  padding: 30rpx;
  color: #98a2b2;
  font-size: 23rpx;
  text-align: center;
}
