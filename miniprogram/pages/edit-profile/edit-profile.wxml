<unread-banner></unread-banner>
<!-- pages/edit-profile/edit-profile.wxml -->
<view class="edit-page">
  <view class="avatar-section">
    <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <view class="avatar-image-wrap">
        <image class="avatar-image" src="{{userInfo.avatar || '/images/logo.png'}}" mode="aspectFill"></image>
        <view class="avatar-camera-badge">
          <image src="/images/icon-camera-white.png" mode="aspectFit"></image>
        </view>
      </view>
      <text class="avatar-hint">点击更换头像</text>
    </button>
  </view>

  <view class="form-group">
    <view class="form-row">
      <text class="form-label">昵称</text>
      <input class="form-input" type="nickname" value="{{userInfo.nickname}}" maxlength="12"
        placeholder="请输入昵称" placeholder-class="placeholder"
        bindinput="onNicknameInput"></input>
    </view>

    <view class="form-row gender-row">
      <text class="form-label">性别</text>
      <view class="gender-options">
        <view class="gender-option {{userInfo.gender === 'male' ? 'active' : ''}}"
          bindtap="onGenderChange" data-value="male">男</view>
        <view class="gender-option {{userInfo.gender === 'female' ? 'active' : ''}}"
          bindtap="onGenderChange" data-value="female">女</view>
        <view class="gender-option {{userInfo.gender === 'secret' || !userInfo.gender ? 'active' : ''}}"
          bindtap="onGenderChange" data-value="secret">保密</view>
      </view>
    </view>

    <view class="form-row">
      <text class="form-label">年龄</text>
      <view class="age-value">
        <input class="form-input age-input" type="number" value="{{userInfo.age}}" maxlength="3"
          placeholder="未设置" placeholder-class="placeholder"
          bindinput="onAgeInput" bindblur="onAgeBlur"></input>
        <text wx:if="{{userInfo.age}}">岁</text>
      </view>
    </view>

    <view class="form-row tappable" bindtap="onOpenRegionModal">
      <text class="form-label">地区</text>
      <view class="row-value">
        <text class="{{userInfo.region ? '' : 'placeholder'}}">{{userInfo.region || '请选择'}}</text>
        <image src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
      </view>
    </view>

    <view class="form-row">
      <text class="form-label">联系方式</text>
      <input class="form-input" type="number" value="{{userInfo.contactPhone}}" maxlength="11"
        placeholder="请输入手机号" placeholder-class="placeholder"
        bindinput="onPhoneInput"></input>
    </view>
  </view>

  <view class="bio-group">
    <text class="bio-label">自我介绍</text>
    <textarea class="bio-input" value="{{userInfo.bio}}" maxlength="200"
      placeholder="介绍一下自己，让更多旅友认识你～"
      placeholder-class="placeholder" bindinput="onBioInput"></textarea>
    <text class="bio-count">{{userInfo.bio.length || 0}}/200</text>
  </view>

  <view class="save-button {{saving ? 'disabled' : ''}}" bindtap="onSave">{{saving ? '保存中...' : '保存'}}</view>
  <view class="bottom-safe"></view>
</view>

<view class="modal-mask" wx:if="{{showRegionModal}}" bindtap="onCloseRegionModal">
  <view class="region-sheet" catchtap="preventBubble">
    <view class="sheet-header">
      <view>
        <text class="sheet-title">选择地区</text>
        <text class="sheet-subtitle">选择区（北京 · 共16个区）</text>
      </view>
      <image class="sheet-close" src="/images/icon-close-gray.png" mode="aspectFit" bindtap="onCloseRegionModal"></image>
    </view>
    <view class="district-grid">
      <view class="district-item {{userInfo.region === item ? 'active' : ''}}"
        wx:for="{{districts}}" wx:key="*this"
        bindtap="onSelectDistrict" data-district="{{item}}">{{item}}</view>
    </view>
    <view class="sheet-safe"></view>
  </view>
</view>
