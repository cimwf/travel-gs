/* pages/edit-profile/edit-profile.wxss */
page {
  --edit-primary: #2783ee;
  --edit-text: #17202b;
  --edit-secondary: #7f8997;
  --edit-border: #e8edf3;
  min-height: 100%;
  background: #f4f9ff;
}

.edit-page {
  min-height: 100vh;
  padding: 26rpx 28rpx 0;
  background: #f4f9ff;
  box-sizing: border-box;
}

.avatar-section {
  width: 100%;
  padding: 8rpx 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-picker {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  padding: 0;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 0;
  background: transparent;
  line-height: 1;
  box-sizing: border-box;
}

.avatar-picker::after {
  border: 0;
}

.avatar-image-wrap {
  position: relative;
  width: 142rpx;
  height: 142rpx;
  flex-shrink: 0;
}

.avatar-image {
  display: block;
  width: 100%;
  height: 100%;
  border: 5rpx solid rgba(255, 255, 255, .96);
  border-radius: 50%;
  background: #d8eaff;
  box-sizing: border-box;
}

.avatar-camera-badge {
  position: absolute;
  left: -4rpx;
  bottom: 2rpx;
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  border-radius: 50%;
  background: var(--edit-primary);
  box-shadow: 0 3rpx 10rpx rgba(39, 131, 238, .28);
  box-sizing: border-box;
  pointer-events: none;
}

.avatar-camera-badge image {
  width: 24rpx;
  height: 24rpx;
}

.avatar-hint {
  color: var(--edit-secondary);
  font-size: 24rpx;
  line-height: 1.4;
}

.form-group,
.bio-group {
  overflow: hidden;
  border: 1rpx solid var(--edit-border);
  border-radius: 26rpx;
  background: #fff;
}

.form-row {
  min-height: 98rpx;
  margin: 0 28rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--edit-border);
  box-sizing: border-box;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-label {
  width: 150rpx;
  flex-shrink: 0;
  color: var(--edit-text);
  font-size: 28rpx;
  font-weight: 500;
}

.form-input {
  min-width: 0;
  height: 98rpx;
  flex: 1;
  color: #596575;
  font-size: 27rpx;
  text-align: right;
}

.placeholder {
  color: #a4acb7;
}

.gender-options {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.gender-option {
  min-width: 76rpx;
  height: 50rpx;
  padding: 0 14rpx;
  border-radius: 27rpx;
  background: #f3f5f7;
  color: var(--edit-secondary);
  font-size: 24rpx;
  line-height: 50rpx;
  text-align: center;
  box-sizing: border-box;
}

.gender-option.active {
  background: #e7f2ff;
  color: var(--edit-primary);
  font-weight: 500;
}

.age-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #596575;
  font-size: 27rpx;
}

.age-input {
  max-width: 160rpx;
}

.row-value {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #596575;
  font-size: 27rpx;
}

.row-value image {
  width: 30rpx;
  height: 30rpx;
  margin-left: 12rpx;
}

.tappable:active,
.gender-option:active {
  opacity: .65;
}

.bio-group {
  position: relative;
  min-height: 224rpx;
  margin-top: 18rpx;
  padding: 26rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.bio-label {
  display: block;
  color: var(--edit-text);
  font-size: 28rpx;
  font-weight: 500;
}

.bio-input {
  width: 100%;
  height: 124rpx;
  margin-top: 14rpx;
  padding: 0 0 32rpx;
  color: #596575;
  font-size: 27rpx;
  line-height: 1.55;
  box-sizing: border-box;
}

.bio-count {
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  color: #a4acb7;
  font-size: 22rpx;
}

.save-button {
  width: 100%;
  height: 88rpx;
  margin: 22rpx 0 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 44rpx;
  background: var(--edit-primary);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
}

.save-button.disabled {
  opacity: .65;
}

.bottom-safe {
  height: calc(34rpx + env(safe-area-inset-bottom));
}

.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, .42);
}

.region-sheet {
  width: 100%;
  padding: 34rpx 30rpx 0;
  border-radius: 34rpx 34rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.sheet-header {
  min-height: 92rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-header > view {
  display: flex;
  flex-direction: column;
}

.sheet-title {
  color: var(--edit-text);
  font-size: 34rpx;
  font-weight: 650;
}

.sheet-subtitle {
  margin-top: 10rpx;
  color: var(--edit-secondary);
  font-size: 24rpx;
}

.sheet-close {
  width: 42rpx;
  height: 42rpx;
  padding: 8rpx;
}

.district-grid {
  padding: 10rpx 0 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.district-item {
  height: 64rpx;
  border: 1rpx solid #dce3ec;
  border-radius: 12rpx;
  background: #fff;
  color: #3f4a58;
  font-size: 25rpx;
  line-height: 64rpx;
  text-align: center;
  box-sizing: border-box;
}

.district-item.active {
  border-color: #72adf3;
  background: #eaf4ff;
  color: var(--edit-primary);
  font-weight: 600;
}

.sheet-safe {
  height: calc(24rpx + env(safe-area-inset-bottom));
}

@media (max-height: 700px) {
  .avatar-section {
    padding-bottom: 18rpx;
  }

  .avatar-image {
    width: 100%;
    height: 100%;
  }

  .avatar-image-wrap {
    width: 118rpx;
    height: 118rpx;
  }

  .avatar-picker {
    width: 176rpx;
    height: 176rpx;
  }

  .form-row,
  .form-input {
    min-height: 88rpx;
    height: 88rpx;
  }

  .bio-group {
    min-height: 194rpx;
  }

  .bio-input {
    height: 100rpx;
  }
}
