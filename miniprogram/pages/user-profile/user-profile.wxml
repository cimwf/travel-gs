<!-- pages/user-profile/user-profile.wxml -->
<view class="profile-page">
  <view class="loading-state" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>

  <block wx:else>
    <view class="profile-summary">
      <view class="identity-row">
        <image class="user-avatar" src="{{userInfo.avatar || '/images/logo.png'}}" mode="aspectFill"></image>
        <view class="identity-copy">
          <view class="profile-name-row">
            <text class="user-name">{{userInfo.nickname}}</text>
            <text class="profile-official-badge" wx:if="{{userInfo.isOfficial}}">官方</text>
          </view>
          <view class="region-row">
            <image class="region-icon" src="/images/icon-location-blue.png" mode="aspectFit"></image>
            <text>{{userInfo.region || '北京市'}}{{userInfo.age ? '·' + userInfo.age + '岁' : ''}}</text>
          </view>
          <text class="user-bio">{{userInfo.bio}}</text>
        </view>
        <view class="edit-btn" wx:if="{{isCurrentUser}}" bindtap="onEditProfile">编辑资料</view>
        <view class="profile-follow-btn {{isFollowing ? 'profile-following-btn' : ''}}"
          wx:else bindtap="onFollowUser">
          {{isMutual ? '相互关注' : (isFollowing ? '已关注' : '关注')}}
        </view>
      </view>

      <view class="social-stats">
        <view class="stat-item" bindtap="onOpenFollowList" data-type="following">
          <text class="stat-number">{{stats.following}}</text>
          <text class="stat-label">关注</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item" bindtap="onOpenFollowList" data-type="followers">
          <text class="stat-number">{{stats.followers}}</text>
          <text class="stat-label">粉丝</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-number">{{stats.receivedLikes}}</text>
          <text class="stat-label">获赞</text>
        </view>
      </view>
    </view>

    <view class="content-tabs">
      <view class="tab-item {{activeTab === 'works' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="works">
        <text>作品 {{stats.works}}</text>
        <view class="tab-line"></view>
      </view>
      <view class="tab-item {{activeTab === 'trips' ? 'active' : ''}}" bindtap="onSwitchTab" data-tab="trips">
        <text>行程 {{stats.trips}}</text>
        <view class="tab-line"></view>
      </view>
    </view>

    <view class="works-list" wx:if="{{activeTab === 'works' && posts.length > 0}}">
      <view class="work-item" wx:for="{{posts}}" wx:key="_id" bindtap="onOpenPost" data-post-id="{{item._id}}">
        <text class="work-text" wx:if="{{item.content}}">{{item.content}}</text>

        <view class="work-images {{item.imageLayout}}" wx:if="{{item.images && item.images.length > 0}}">
          <image wx:for="{{item.images}}" wx:for-item="img" wx:key="key"
            class="work-image" src="{{img.url}}" mode="aspectFill"
            catchtap="onPreviewImage" data-current="{{img.url}}" data-urls="{{item.imageUrls}}">
          </image>
        </view>

        <view class="work-meta">
          <view class="meta-left">
            <text class="work-time">{{item.timeText}}</text>
            <view class="location-pill" wx:if="{{item.hasLocation}}" catchtap="onOpenLocation"
              data-lat="{{item.location.latitude}}" data-lng="{{item.location.longitude}}"
              data-name="{{item.location.name}}" data-address="{{item.location.address}}">
              <image src="/images/icon-location-blue.png" mode="aspectFit"></image>
              <text>{{item.location.name}}</text>
            </view>
          </view>
          <view class="work-actions">
            <view class="action-item {{item.isLiked ? 'liked' : ''}}" catchtap="onLikeTap" data-post-id="{{item._id}}">
              <image src="{{item.isLiked ? '/images/icon-like-heart-active.svg' : '/images/icon-like-heart-gray.svg'}}" mode="aspectFit"></image>
              <text>{{item.likeCount}}</text>
            </view>
            <view class="action-item" catchtap="onOpenPost" data-post-id="{{item._id}}">
              <image src="/images/icon-comment-gray.svg" mode="aspectFit"></image>
              <text>{{item.commentCount}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="trip-list" wx:elif="{{activeTab === 'trips' && trips.length > 0}}">
      <view class="trip-card" wx:for="{{trips}}" wx:key="_id" bindtap="onTripTap" data-id="{{item._id}}">
        <image class="trip-card-cover" src="{{item.placeCoverImage}}" mode="aspectFill"
          wx:if="{{item.placeCoverImage}}"></image>
        <view class="trip-card-avatar-cover" wx:else>
          <image class="trip-creator-avatar" src="{{item.creatorAvatar}}" mode="aspectFill"
            wx:if="{{item.creatorAvatar}}"></image>
          <view class="trip-creator-avatar trip-creator-avatar-placeholder" wx:else>
            <text>{{item.creatorInitial}}</text>
          </view>
          <text class="trip-creator-label">{{item.creatorName}} 发起</text>
        </view>

        <view class="trip-card-body">
          <view class="trip-card-title-row">
            <text class="trip-card-title">{{item.displayTitle || item.placeName}}</text>
            <text class="trip-status {{item.statusClass}}">{{item.statusText}}</text>
          </view>

          <view class="trip-card-meta-row">
            <image src="/images/icon-profile-calendar.svg" mode="aspectFit"></image>
            <text>{{item.dateText}}{{item.departureTimeText ? ' ' + item.departureTimeText + ' 出发' : ''}}</text>
          </view>

          <view class="trip-card-meta-row">
            <image src="/images/icon-location-blue.png" mode="aspectFit"></image>
            <text>{{item.meetingLocation}}</text>
          </view>

          <view class="trip-card-footer">
            <view class="trip-card-people">
              <view class="participants">
                <block wx:for="{{item.displayParticipants}}" wx:for-item="p" wx:key="userId">
                  <image class="participant-avatar" src="{{p.avatar}}" mode="aspectFill" wx:if="{{p.avatar}}"></image>
                  <view class="participant-avatar participant-placeholder" wx:else>
                    <text>{{p.initial}}</text>
                  </view>
                </block>
              </view>
              <text class="participant-count">共{{item.participantCount}}人</text>
            </view>
            <text class="trip-publish-time" wx:if="{{item.publishTime}}">{{item.publishTime}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{activeTab === 'works' && posts.length === 0}}">
      <text class="empty-title">还没有公开作品</text>
      <text class="empty-desc">审核通过的作品会展示在这里</text>
    </view>
    <view class="empty-state" wx:if="{{activeTab === 'trips' && trips.length === 0}}">
      <text class="empty-title">还没有发布行程</text>
      <text class="empty-desc">发布的行程会展示在这里</text>
    </view>
  </block>
</view>
