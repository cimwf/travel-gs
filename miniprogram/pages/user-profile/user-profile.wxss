/* pages/user-profile/user-profile.wxss */
page {
  --profile-primary: #2783ee;
  --profile-text: #17202b;
  --profile-secondary: #7f8997;
  --profile-border: #e8edf3;
  min-height: 100%;
  background: #f4f9ff;
}

.profile-page {
  min-height: 100vh;
  background: #f4f9ff;
}

.loading-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--profile-secondary);
  font-size: 26rpx;
}

.loading-spinner {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 18rpx;
  border: 4rpx solid var(--profile-border);
  border-top-color: var(--profile-primary);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.profile-summary {
  padding: 38rpx 34rpx 0;
}

.identity-row {
  min-height: 174rpx;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border: 5rpx solid rgba(255, 255, 255, .95);
  border-radius: 50%;
  background: #d8eaff;
  box-sizing: border-box;
}

.identity-copy {
  min-width: 0;
  margin-left: 26rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  overflow: hidden;
  color: var(--profile-text);
  font-size: 36rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.region-row {
  margin-top: 9rpx;
  display: flex;
  align-items: center;
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.region-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 7rpx;
}

.user-bio {
  max-width: 380rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: #5e6977;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-btn {
  min-width: 146rpx;
  height: 62rpx;
  margin-left: 18rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--profile-primary);
  border-radius: 32rpx;
  color: var(--profile-primary);
  font-size: 25rpx;
  line-height: 62rpx;
  text-align: center;
  box-sizing: border-box;
}

.edit-btn:active,
.tab-item:active,
.trip-card:active,
.work-item:active {
  opacity: .68;
}

.social-stats {
  height: 142rpx;
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  color: var(--profile-primary);
  font-size: 37rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 9rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: #dce4ed;
}

.content-tabs {
  height: 96rpx;
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid var(--profile-border);
  border-bottom: 1rpx solid var(--profile-border);
  background: rgba(255, 255, 255, .46);
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--profile-secondary);
  font-size: 29rpx;
  font-weight: 500;
}

.tab-item.active {
  color: var(--profile-text);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 44rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: transparent;
}

.tab-item.active .tab-line {
  background: var(--profile-primary);
}

.works-list {
  background: #fff;
}

.work-item {
  padding: 30rpx 30rpx 24rpx;
  border-bottom: 1rpx solid var(--profile-border);
}

.work-text {
  display: block;
  color: var(--profile-text);
  font-size: 29rpx;
  line-height: 1.65;
  word-break: break-all;
}

.work-images {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.work-images.grid-1 .work-image {
  width: 100%;
  height: 330rpx;
  border-radius: 18rpx;
}

.work-images.grid-2 .work-image {
  width: calc((100% - 8rpx) / 2);
  height: 248rpx;
  border-radius: 14rpx;
}

.work-images.grid-3 .work-image {
  width: calc((100% - 16rpx) / 3);
  height: 206rpx;
  border-radius: 12rpx;
}

.work-image {
  background: var(--profile-border);
  flex-shrink: 0;
}

.work-meta {
  min-height: 58rpx;
  padding-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-left {
  min-width: 0;
  display: flex;
  align-items: center;
}

.work-time {
  color: var(--profile-secondary);
  font-size: 22rpx;
  white-space: nowrap;
}

.location-pill {
  max-width: 260rpx;
  margin-left: 16rpx;
  padding: 7rpx 14rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  background: #f1f7fe;
  box-sizing: border-box;
}

.location-pill image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.location-pill text {
  overflow: hidden;
  color: #718096;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-actions {
  margin-left: 18rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-item {
  min-width: 66rpx;
  display: flex;
  align-items: center;
  color: #8390a6;
  font-size: 23rpx;
}

.action-item image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 7rpx;
}

.action-item.liked {
  color: #f04455;
}

.trip-list {
  padding: 22rpx 26rpx 36rpx;
}

.trip-card {
  min-height: 176rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--profile-border);
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

.trip-cover {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 18rpx;
  background: #d8eaff;
}

.trip-copy {
  min-width: 0;
  margin-left: 22rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.trip-title {
  overflow: hidden;
  color: var(--profile-text);
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-place,
.trip-meta {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--profile-secondary);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-arrow {
  width: 30rpx;
  height: 30rpx;
  margin-left: 12rpx;
}

.empty-state {
  min-height: 360rpx;
  padding: 90rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.empty-title {
  color: var(--profile-text);
  font-size: 29rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 12rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
}
