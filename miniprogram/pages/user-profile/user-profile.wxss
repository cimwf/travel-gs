/* pages/user-profile/user-profile.wxss */
page {
  --profile-primary: #2783ee;
  --profile-text: #17202b;
  --profile-secondary: #7f8997;
  --profile-border: #e8edf3;
  min-height: 100%;
  background: #f4f9ff;
}

.profile-page {
  min-height: 100vh;
  background: #f4f9ff;
}

.loading-state {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--profile-secondary);
  font-size: 26rpx;
}

.loading-spinner {
  width: 46rpx;
  height: 46rpx;
  margin-bottom: 18rpx;
  border: 4rpx solid var(--profile-border);
  border-top-color: var(--profile-primary);
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.profile-summary {
  padding: 38rpx 34rpx 0;
}

.identity-row {
  min-height: 174rpx;
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border: 5rpx solid rgba(255, 255, 255, .95);
  border-radius: 50%;
  background: #d8eaff;
  box-sizing: border-box;
}

.identity-copy {
  min-width: 0;
  margin-left: 26rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  overflow: hidden;
  color: var(--profile-text);
  font-size: 36rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.region-row {
  margin-top: 9rpx;
  display: flex;
  align-items: center;
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.region-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 7rpx;
}

.user-bio {
  max-width: 380rpx;
  margin-top: 10rpx;
  overflow: hidden;
  color: #5e6977;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-btn {
  min-width: 146rpx;
  height: 62rpx;
  margin-left: 18rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--profile-primary);
  border-radius: 32rpx;
  color: var(--profile-primary);
  font-size: 25rpx;
  line-height: 62rpx;
  text-align: center;
  box-sizing: border-box;
}

.profile-follow-btn {
  min-width: 146rpx;
  height: 62rpx;
  margin-left: 18rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--profile-primary);
  border-radius: 32rpx;
  background: var(--profile-primary);
  color: #fff;
  font-size: 25rpx;
  line-height: 58rpx;
  text-align: center;
  box-sizing: border-box;
}

.profile-following-btn {
  background: transparent;
  color: var(--profile-primary);
}

.edit-btn:active,
.profile-follow-btn:active,
.tab-item:active,
.trip-card:active,
.work-item:active {
  opacity: .68;
}

.social-stats {
  height: 142rpx;
  display: flex;
  align-items: center;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-number {
  color: var(--profile-primary);
  font-size: 37rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 9rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
}

.stat-divider {
  width: 1rpx;
  height: 52rpx;
  background: #dce4ed;
}

.content-tabs {
  height: 96rpx;
  display: flex;
  align-items: stretch;
  border-top: 1rpx solid var(--profile-border);
  border-bottom: 1rpx solid var(--profile-border);
  background: rgba(255, 255, 255, .46);
}

.tab-item {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--profile-secondary);
  font-size: 29rpx;
  font-weight: 500;
}

.tab-item.active {
  color: var(--profile-text);
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 44rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: transparent;
}

.tab-item.active .tab-line {
  background: var(--profile-primary);
}

.works-list {
  background: #fff;
}

.work-item {
  padding: 30rpx 30rpx 24rpx;
  border-bottom: 1rpx solid var(--profile-border);
}

.work-text {
  display: block;
  color: var(--profile-text);
  font-size: 29rpx;
  line-height: 1.65;
  word-break: break-all;
}

.work-images {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.work-images.grid-1 .work-image {
  width: 100%;
  height: 330rpx;
  border-radius: 18rpx;
}

.work-images.grid-2 .work-image {
  width: calc((100% - 8rpx) / 2);
  height: 248rpx;
  border-radius: 14rpx;
}

.work-images.grid-3 .work-image {
  width: calc((100% - 16rpx) / 3);
  height: 206rpx;
  border-radius: 12rpx;
}

.work-image {
  background: var(--profile-border);
  flex-shrink: 0;
}

.work-meta {
  min-height: 58rpx;
  padding-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.meta-left {
  min-width: 0;
  display: flex;
  align-items: center;
}

.work-time {
  color: var(--profile-secondary);
  font-size: 22rpx;
  white-space: nowrap;
}

.location-pill {
  max-width: 260rpx;
  margin-left: 16rpx;
  padding: 7rpx 14rpx;
  display: flex;
  align-items: center;
  border-radius: 24rpx;
  background: #f1f7fe;
  box-sizing: border-box;
}

.location-pill image {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
  flex-shrink: 0;
}

.location-pill text {
  overflow: hidden;
  color: #718096;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-actions {
  margin-left: 18rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.action-item {
  min-width: 66rpx;
  display: flex;
  align-items: center;
  color: #8390a6;
  font-size: 23rpx;
}

.action-item image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 7rpx;
}

.action-item.liked {
  color: #f04455;
}

.trip-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx 32rpx 40rpx;
}

.trip-card {
  border: 1rpx solid var(--profile-border);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(54, 96, 142, .07);
  overflow: hidden;
}

.trip-card:active {
  opacity: .88;
}

.trip-card-cover,
.trip-card-avatar-cover {
  width: 100%;
  height: 250rpx;
}

.trip-card-cover {
  display: block;
  background: #e8eef5;
}

.trip-card-avatar-cover {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #eaf4ff;
  box-sizing: border-box;
}

.trip-creator-avatar {
  width: 104rpx;
  height: 104rpx;
  border: 5rpx solid rgba(255, 255, 255, .96);
  border-radius: 50%;
  background: #d5e9ff;
  box-shadow: 0 5rpx 16rpx rgba(62, 119, 181, .15);
  box-sizing: border-box;
}

.trip-creator-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--profile-primary);
  font-size: 38rpx;
  font-weight: 600;
}

.trip-creator-label {
  margin-top: 14rpx;
  color: #6f7c8d;
  font-size: 24rpx;
}

.trip-card-body {
  padding: 22rpx 24rpx 24rpx;
}

.trip-card-title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.trip-card-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: var(--profile-text);
  font-size: 33rpx;
  font-weight: 650;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-status {
  height: 46rpx;
  flex-shrink: 0;
  padding: 0 18rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  font-weight: 500;
  line-height: 46rpx;
  box-sizing: border-box;
}

.trip-status.recruiting {
  background: rgba(82, 196, 26, .1);
  color: #52c41a;
}

.trip-status.ongoing {
  background: rgba(74, 144, 226, .12);
  color: #4a90e2;
}

.trip-status.almost-full {
  background: rgba(250, 173, 20, .1);
  color: #faad14;
}

.trip-status.full {
  background: rgba(140, 140, 160, .1);
  color: #8e8ea0;
}

.trip-status.stopped {
  background: rgba(255, 77, 79, .1);
  color: #ff4d4f;
}

.trip-status.ended,
.trip-status.cancelled {
  background: #f5f5f5;
  color: #8e8ea0;
}

.trip-card-meta-row {
  min-width: 0;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  color: #778394;
  font-size: 25rpx;
  line-height: 1.35;
}

.trip-card-meta-row image {
  width: 30rpx;
  height: 30rpx;
  margin-right: 13rpx;
  flex-shrink: 0;
}

.trip-card-meta-row text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-card-footer {
  min-height: 58rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trip-card-people,
.participants {
  display: flex;
  align-items: center;
}

.trip-card .participant-avatar {
  width: 50rpx;
  height: 50rpx;
  margin-left: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  border-radius: 50%;
  background: #d9eaff;
  color: var(--profile-primary);
  font-size: 19rpx;
  box-sizing: border-box;
}

.trip-card .participant-avatar:first-child {
  margin-left: 0;
}

.participant-count {
  margin-left: 14rpx;
  color: #778394;
  font-size: 24rpx;
  white-space: nowrap;
}

.trip-publish-time {
  margin-left: 16rpx;
  color: #9aa5b3;
  font-size: 23rpx;
  white-space: nowrap;
}

.empty-state {
  min-height: 360rpx;
  padding: 90rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.empty-title {
  color: var(--profile-text);
  font-size: 29rpx;
  font-weight: 600;
}

.empty-desc {
  margin-top: 12rpx;
  color: var(--profile-secondary);
  font-size: 24rpx;
}
