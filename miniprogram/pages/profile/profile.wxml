<unread-banner></unread-banner>
<view class="profile-page">
  <view class="profile-safe-area" style="height: {{statusBarHeight + navBarHeight}}px;"></view>

  <view class="profile-content">
    <view class="profile-identity" wx:if="{{!isLoggedIn}}" bindtap="onLogin">
      <view class="avatar avatar-placeholder"><text>旅</text></view>
      <view class="identity-copy">
        <text class="identity-name">点击登录</text>
        <text class="identity-bio">登录后查看个人信息</text>
      </view>
      <image class="menu-arrow" src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
    </view>

    <view class="profile-identity" wx:else bindtap="onTapMyProfile">
      <image class="avatar" src="{{userInfo.avatar || userInfo.avatarUrl}}" mode="aspectFill"
        wx:if="{{userInfo.avatar || userInfo.avatarUrl}}"></image>
      <view class="avatar avatar-placeholder" wx:else>
        <text>{{userInfo.nickname ? userInfo.nickname[0] : '旅'}}</text>
      </view>
      <view class="identity-copy">
        <text class="identity-name">{{userInfo.nickname || userInfo.nickName || '旅行者'}}</text>
        <text class="identity-bio">{{userInfo.bio || '喜欢户外运动，周末出游'}}</text>
      </view>
      <image class="menu-arrow" src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
    </view>

    <view class="social-stats">
      <view class="stat-item" bindtap="onTapSocialStat" data-type="following">
        <text class="stat-number">{{stats.following || 0}}</text>
        <text class="stat-label">关注</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onTapSocialStat" data-type="followers">
        <text class="stat-number">{{stats.followers || 0}}</text>
        <text class="stat-label">粉丝</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="onTapReceivedLikes">
        <text class="stat-number">{{stats.receivedLikes || 0}}</text>
        <text class="stat-label">获赞</text>
      </view>
    </view>

    <view class="menu-stack">
      <view class="menu-group">
        <view class="menu-row" bindtap="onTapMyTrips">
          <image class="menu-icon" src="/images/icon-profile-calendar.svg" mode="aspectFit"></image>
          <text class="menu-title">我的行程</text>
          <text class="menu-count" wx:if="{{stats.trips > 0}}">{{stats.trips}}</text>
          <image class="menu-arrow" src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
        </view>
        <view class="menu-row" bindtap="onTapMyWorks">
          <image class="menu-icon" src="/images/icon-profile-photo.svg" mode="aspectFit"></image>
          <text class="menu-title">我的作品</text>
          <text class="menu-count" wx:if="{{stats.works > 0}}">{{stats.works}}</text>
          <image class="menu-arrow" src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
        </view>
        <view class="menu-row" bindtap="onTapInteractionRecords">
          <image class="menu-icon" src="/images/icon-profile-interaction.svg" mode="aspectFit"></image>
          <text class="menu-title">我的互动</text>
          <image class="menu-arrow" src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
        </view>
        <view class="menu-row" bindtap="onTapTripNotifications">
          <image class="menu-icon" src="/images/icon-profile-bell.svg" mode="aspectFit"></image>
          <view class="menu-copy">
            <text class="menu-title">消息中心</text>
            <text class="menu-subtitle">行程通知、赞、评论与回复</text>
          </view>
          <view class="menu-badge" wx:if="{{unreadCount > 0}}">{{unreadCount > 99 ? '99+' : unreadCount}}</view>
          <image class="menu-arrow" src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
        </view>
      </view>

      <view class="menu-group menu-group-secondary">
        <view class="menu-row" bindtap="onTapUploadSpot">
          <image class="menu-icon" src="/images/icon-profile-location.svg" mode="aspectFit"></image>
          <text class="menu-title">上传景点</text>
          <image class="menu-arrow" src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
        </view>
        <view class="menu-row" bindtap="onTapFeedback">
          <image class="menu-icon" src="/images/icon-profile-pencil.svg" mode="aspectFit"></image>
          <text class="menu-title">提交建议</text>
          <image class="menu-arrow" src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
        </view>
        <view class="menu-row" bindtap="onTapAbout">
          <image class="menu-icon" src="/images/icon-profile-info.svg" mode="aspectFit"></image>
          <text class="menu-title">关于我们</text>
          <image class="menu-arrow" src="/images/icon-profile-chevron.svg" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>
</view>
