/* pages/profile/profile.wxss */

page {
  --profile-primary: #2783ee;
  --profile-text: #17202b;
  --profile-secondary: #7f8997;
  --profile-border: #e8edf3;
  min-height: 100%;
  background: #f4f9ff;
}

.profile-page {
  min-height: 100vh;
  padding-bottom: 36rpx;
  background: #f4f9ff;
  box-sizing: border-box;
}

.profile-safe-area {
  width: 100%;
  background: #f4f9ff;
  box-sizing: border-box;
}

.profile-content {
  padding: 34rpx 28rpx 0;
}

.profile-identity {
  min-height: 164rpx;
  padding: 6rpx 18rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.profile-identity:active,
.stat-item:not(.stat-item-static):active,
.menu-row:active {
  opacity: .66;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  flex-shrink: 0;
  border: 5rpx solid rgba(255, 255, 255, .92);
  border-radius: 50%;
  background: #d8eaff;
  box-sizing: border-box;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--profile-primary);
  font-size: 46rpx;
  font-weight: 650;
}

.identity-copy {
  min-width: 0;
  margin-left: 28rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.identity-name {
  overflow: hidden;
  color: var(--profile-text);
  font-size: 38rpx;
  font-weight: 650;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-bio {
  margin-top: 12rpx;
  overflow: hidden;
  color: var(--profile-secondary);
  font-size: 25rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.social-stats {
  height: 138rpx;
  padding: 8rpx 14rpx 18rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.stat-item {
  height: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.stat-number {
  color: var(--profile-primary);
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.1;
}

.stat-label {
  margin-top: 12rpx;
  color: var(--profile-secondary);
  font-size: 25rpx;
}

.stat-divider {
  width: 1rpx;
  height: 58rpx;
  background: #dce4ed;
}

.menu-stack {
  margin-top: 8rpx;
}

.menu-group {
  overflow: hidden;
  border: 1rpx solid var(--profile-border);
  border-radius: 30rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(54, 96, 142, .055);
}

.menu-group-secondary {
  margin-top: 14rpx;
}

.menu-row {
  min-height: 116rpx;
  margin: 0 28rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--profile-border);
  box-sizing: border-box;
}

.menu-row:last-child {
  border-bottom: 0;
}

.menu-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.menu-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
}

.menu-title {
  min-width: 0;
  flex: 1;
  color: var(--profile-text);
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.25;
}

.menu-subtitle {
  max-width: 270rpx;
  margin-left: 16rpx;
  overflow: hidden;
  color: var(--profile-secondary);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-count {
  margin-left: 18rpx;
  color: var(--profile-secondary);
  font-size: 25rpx;
}

.menu-badge {
  min-width: 40rpx;
  height: 40rpx;
  margin-left: 16rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #f04444;
  color: #fff;
  font-size: 21rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.menu-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

@media (max-height: 700px) {
  .profile-content {
    padding-top: 18rpx;
  }

  .profile-identity {
    min-height: 142rpx;
  }

  .avatar {
    width: 112rpx;
    height: 112rpx;
  }

  .social-stats {
    height: 118rpx;
  }

  .menu-row {
    min-height: 102rpx;
  }
}
