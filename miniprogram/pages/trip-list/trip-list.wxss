/* pages/trip-list/trip-list.wxss */

page {
  --primary-color: #4A90E2;
  --primary-light: #6BA3E8;
  --primary-dark: #357ABD;
  --text-primary: #1A1A2E;
  --text-secondary: #4A4A68;
  --text-hint: #8E8EA0;
  --bg-color: #F5F7FA;
  --card-bg: #FFFFFF;
  --border-color: #E8E8F0;
  --success-color: #52C41A;
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

page {
  background: var(--bg-color);
  width: 100%;
  overflow-x: hidden;
}

.container {
  height: 100vh;
  background: var(--bg-color);
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ========== 筛选栏 ========== */
.filter-bar {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: white;
  border-bottom: 1rpx solid var(--border-color);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  
}

.filter-bar::-webkit-scrollbar {
  display: none;
}

.filter-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 14rpx 24rpx;
  background: var(--bg-color);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-item.active {
  background: rgba(74, 144, 226, 0.1);
  color: var(--primary-color);
}

.filter-arrow {
  font-size: 20rpx;
}

/* ========== 列表区域 ========== */
.list-container {
  flex: 1;
  height: 0;
}

.list-content {
  padding: 24rpx 32rpx 160rpx;
}

.trip-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ========== 行程卡片 ========== */
.trip-card {
  background: white;
  border-radius: 32rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.trip-header {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.trip-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.trip-img image {
  width: 100%;
  height: 100%;
}

.trip-emoji {
  font-size: 56rpx;
}

.trip-info {
  flex: 1;
  min-width: 0;
}

.trip-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.trip-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

/* ========== 状态标签 ========== */
.trip-status {
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.trip-status.recruiting {
  background: rgba(82, 196, 26, 0.1);
  color: #52C41A;
}

.trip-status.ongoing {
  background: rgba(74, 144, 226, 0.12);
  color: #4A90E2;
}

.trip-status.almost-full {
  background: rgba(250, 173, 20, 0.1);
  color: #FAAD14;
}

.trip-status.full {
  background: rgba(140, 140, 160, 0.1);
  color: #8E8EA0;
}

.trip-status.stopped {
  background: rgba(255, 77, 79, 0.1);
  color: #FF4D4F;
}

.trip-status.ended {
  background: #F5F5F5;
  color: #8E8EA0;
}

.trip-status.cancelled {
  background: #F5F5F5;
  color: #8E8EA0;
}

.trip-meta {
  font-size: 24rpx;
  color: var(--text-hint);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx;
}

.trip-meta-second {
  margin-top: 8rpx;
}

.meta-dot {
  color: var(--border-color);
  margin: 0 4rpx;
}

/* ========== 底部信息 ========== */
.trip-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trip-footer-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.participants {
  display: flex;
  align-items: center;
}

.participant-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid white;
  margin-left: -12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.participant-avatar:first-child {
  margin-left: 0;
}

.trip-need {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.publish-time {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 24rpx 80rpx;
}

.empty-hero {
  position: relative;
  width: 100%;
  display: flex;
  justify-content: center;
  margin-bottom: 44rpx;
}

.empty-glow {
  position: absolute;
  top: 20rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  filter: blur(18rpx);
  opacity: 0.75;
}

.empty-glow-left {
  left: 52rpx;
  background: rgba(111, 201, 190, 0.22);
}

.empty-glow-right {
  right: 40rpx;
  background: rgba(255, 188, 107, 0.24);
}

.empty-scene {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  height: 360rpx;
  background: linear-gradient(180deg, #eaf6ff 0%, #f8fbff 44%, #ffffff 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  box-shadow: 0 28rpx 60rpx rgba(59, 95, 140, 0.12);
  overflow: hidden;
}

.scene-sky {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 110rpx;
  background: linear-gradient(180deg, #dff0ff 0%, rgba(223, 240, 255, 0.2) 100%);
}

.scene-sun {
  position: absolute;
  top: 46rpx;
  right: 88rpx;
  width: 64rpx;
  height: 64rpx;
  background: radial-gradient(circle at 35% 35%, #fff7cf 0%, #ffd776 68%, #ffc24b 100%);
  border-radius: 50%;
  box-shadow: 0 0 32rpx rgba(255, 200, 84, 0.35);
}

.scene-cloud {
  position: absolute;
  height: 22rpx;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 999rpx;
}

.scene-cloud::before,
.scene-cloud::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 50%;
}

.scene-cloud::before {
  left: 18rpx;
  width: 30rpx;
  height: 30rpx;
}

.scene-cloud::after {
  right: 16rpx;
  width: 24rpx;
  height: 24rpx;
}

.scene-cloud-one {
  top: 68rpx;
  left: 72rpx;
  width: 92rpx;
}

.scene-cloud-two {
  top: 104rpx;
  right: 168rpx;
  width: 78rpx;
}

.scene-mountain {
  position: absolute;
  border-radius: 50%;
}

.mountain-back {
  left: -40rpx;
  right: -40rpx;
  bottom: 72rpx;
  height: 220rpx;
  background: linear-gradient(180deg, #b7d9c9 0%, #8fc0a7 100%);
}

.mountain-front {
  left: -60rpx;
  right: -60rpx;
  bottom: -62rpx;
  height: 260rpx;
  background: linear-gradient(180deg, #7cb497 0%, #5b9478 100%);
}

.scene-route {
  position: absolute;
  left: 76rpx;
  right: 84rpx;
  bottom: 74rpx;
  height: 84rpx;
}

.route-path {
  position: absolute;
  left: 24rpx;
  right: 40rpx;
  top: 32rpx;
  height: 8rpx;
  border-top: 6rpx dashed rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  transform: rotate(-8deg);
}

.route-dot,
.route-pin {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-dot {
  width: 18rpx;
  height: 18rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 0 8rpx rgba(255, 255, 255, 0.25);
}

.route-dot-start {
  left: 0;
  top: 40rpx;
}

.route-pin {
  right: 0;
  top: 0;
  width: 52rpx;
  height: 52rpx;
  background: linear-gradient(135deg, #ff936c 0%, #ff6f61 100%);
  color: #ffffff;
  font-size: 24rpx;
  border-radius: 20rpx 20rpx 20rpx 4rpx;
  box-shadow: 0 14rpx 24rpx rgba(255, 111, 97, 0.28);
  transform: rotate(12deg);
}

.scene-card {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: 26rpx;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(70, 96, 128, 0.1);
}

.scene-card-badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(74, 144, 226, 0.1);
  color: var(--primary-color);
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.scene-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.scene-card-meta {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.scene-card-sep {
  margin: 0 10rpx;
}

.empty-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 16rpx;
}

.empty-desc {
  max-width: 540rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-hint);
  text-align: center;
  margin-bottom: 24rpx;
}

.empty-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.empty-tag {
  padding: 12rpx 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(74, 144, 226, 0.12);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(89, 111, 145, 0.06);
  font-size: 22rpx;
  color: var(--text-secondary);
}

.empty-btn {
  min-width: 320rpx;
  padding: 26rpx 64rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #67b2ff 100%);
  color: white;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 18rpx 32rpx rgba(74, 144, 226, 0.24);
}

.empty-hint {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: var(--text-hint);
  text-align: center;
}

/* ========== 加载状态 ========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--text-hint);
  font-size: 26rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 16rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ========== 加载更多 ========== */
.load-more {
  text-align: center;
  padding: 32rpx;
  color: var(--text-hint);
  font-size: 24rpx;
}

.no-more {
  text-align: center;
  padding: 32rpx;
  color: var(--text-hint);
  font-size: 24rpx;
}

/* ========== 悬浮发布按钮 ========== */
.fab {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
}

.fab:active {
  opacity: 0.9;
  transform: scale(0.95);
}

.fab-inner {
  width: 88rpx;
  height: 88rpx;
  border: 3rpx dashed var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-icon {
  font-size: 56rpx;
  color: var(--primary-color);
  font-weight: 300;
}

/* ========== 筛选弹窗 ========== */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 200;
}

.filter-panel {
  position: absolute;
  top: 200rpx;
  left: 32rpx;
  right: 32rpx;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.filter-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.filter-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.filter-reset {
  font-size: 26rpx;
  color: var(--primary-color);
}

.filter-options {
  padding: 16rpx;
  max-height: 600rpx;
  overflow-y: auto;
}

.filter-option {
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-radius: 16rpx;
  margin-bottom: 8rpx;
}

.filter-option:last-child {
  margin-bottom: 0;
}

.filter-option.selected {
  background: rgba(74, 144, 226, 0.1);
  color: var(--primary-color);
  font-weight: 500;
}

.filter-option:active {
  background: var(--bg-color);
}

/* ========== 自定义日期选择弹窗 ========== */
.date-picker-panel {
  position: absolute;
  top: 300rpx;
  left: 32rpx;
  right: 32rpx;
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.date-picker-content {
  padding: 32rpx;
}

.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.date-row:last-child {
  border-bottom: none;
}

.date-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.date-value {
  font-size: 28rpx;
  color: var(--primary-color);
  padding: 12rpx 24rpx;
  background: rgba(74, 144, 226, 0.1);
  border-radius: 12rpx;
}

.date-picker-footer {
  display: flex;
  border-top: 1rpx solid var(--border-color);
}

.date-btn {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
}

.date-btn-cancel {
  color: var(--text-hint);
  border-right: 1rpx solid var(--border-color);
}

.date-btn-confirm {
  color: var(--primary-color);
  font-weight: 500;
}

/* ========== 行程大图卡片 ========== */
.trip-card {
  padding: 0;
  overflow: hidden;
  border: 1rpx solid #e8edf3;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(54, 96, 142, .07);
}

.trip-card:active {
  opacity: .88;
}

.trip-card-cover,
.trip-card-avatar-cover {
  width: 100%;
  height: 250rpx;
}

.trip-card-cover {
  display: block;
  background: #e8eef5;
}

.trip-card-avatar-cover {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #eaf4ff;
  box-sizing: border-box;
}

.trip-creator-avatar {
  width: 104rpx;
  height: 104rpx;
  border: 5rpx solid rgba(255, 255, 255, .96);
  border-radius: 50%;
  background: #d5e9ff;
  box-shadow: 0 5rpx 16rpx rgba(62, 119, 181, .15);
  box-sizing: border-box;
}

.trip-creator-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2783ee;
  font-size: 38rpx;
  font-weight: 600;
}

.trip-creator-label {
  margin-top: 14rpx;
  color: #6f7c8d;
  font-size: 24rpx;
}

.trip-card-body {
  padding: 22rpx 24rpx 24rpx;
}

.trip-card-title-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.trip-card-title {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  color: #17202b;
  font-size: 33rpx;
  font-weight: 650;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-card .trip-status {
  height: 46rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  font-size: 23rpx;
  line-height: 46rpx;
  box-sizing: border-box;
}

.trip-card-meta-row {
  min-width: 0;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  color: #778394;
  font-size: 25rpx;
  line-height: 1.35;
}

.trip-card-meta-row image {
  width: 30rpx;
  height: 30rpx;
  margin-right: 13rpx;
  flex-shrink: 0;
}

.trip-card-meta-row text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-card-footer {
  min-height: 58rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trip-card-people,
.participants {
  display: flex;
  align-items: center;
}

.trip-card .participant-avatar {
  width: 50rpx;
  height: 50rpx;
  margin-left: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  border-radius: 50%;
  background: #d9eaff;
  color: #2783ee;
  font-size: 19rpx;
  box-shadow: none;
  box-sizing: border-box;
}

.trip-card .participant-avatar:first-child {
  margin-left: 0;
}

.participant-count {
  margin-left: 14rpx;
  color: #778394;
  font-size: 24rpx;
  white-space: nowrap;
}

.trip-publish-time {
  margin-left: 16rpx;
  color: #9aa5b3;
  font-size: 23rpx;
  white-space: nowrap;
}
