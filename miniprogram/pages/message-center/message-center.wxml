<view class="message-page">
  <view class="message-login" wx:if="{{!isLoggedIn}}">
    <view class="message-login-icon">
      <image src="/images/icon-profile-bell.svg" mode="aspectFit"></image>
    </view>
    <view class="message-login-title">登录后查看消息</view>
    <view class="message-login-desc">行程动态、点赞、评论与回复都会显示在这里</view>
    <view class="message-login-btn" bindtap="onLogin">立即登录</view>
  </view>

  <block wx:else>
    <view class="message-filter">
      <view class="message-filter-item {{activeFilter === 'all' ? 'message-filter-active' : ''}}" data-filter="all" bindtap="onFilterTap">
        <text>全部</text>
        <view class="message-filter-badge" wx:if="{{counts.all > 0}}">{{counts.all > 99 ? '99+' : counts.all}}</view>
      </view>
      <view class="message-filter-item {{activeFilter === 'trip' ? 'message-filter-active' : ''}}" data-filter="trip" bindtap="onFilterTap">
        <text>行程</text>
        <view class="message-filter-badge" wx:if="{{counts.trip > 0}}">{{counts.trip > 99 ? '99+' : counts.trip}}</view>
      </view>
      <view class="message-filter-item {{activeFilter === 'interaction' ? 'message-filter-active' : ''}}" data-filter="interaction" bindtap="onFilterTap">
        <text>互动</text>
        <view class="message-filter-badge" wx:if="{{counts.interaction > 0}}">{{counts.interaction > 99 ? '99+' : counts.interaction}}</view>
      </view>
    </view>

    <view class="message-toolbar">
      <text class="message-list-title">{{activeFilter === 'all' ? '全部消息' : (activeFilter === 'trip' ? '行程通知' : '互动消息')}}</text>
      <text class="message-read-all {{counts.all === 0 ? 'message-read-disabled' : ''}}" bindtap="onMarkAllRead">全部已读</text>
    </view>

    <view class="message-loading" wx:if="{{loading}}">
      <view class="message-loading-line message-loading-line-short"></view>
      <view class="message-loading-line"></view>
      <view class="message-loading-line"></view>
      <view class="message-loading-line message-loading-line-short"></view>
    </view>

    <view class="message-error" wx:elif="{{error}}">
      <view class="message-empty-icon">
        <image src="/images/icon-profile-bell.svg" mode="aspectFit"></image>
      </view>
      <view class="message-empty-title">消息加载失败</view>
      <view class="message-empty-desc">请检查网络后重新尝试</view>
      <view class="message-retry-btn" bindtap="onRetry">重新加载</view>
    </view>

    <view class="message-empty" wx:elif="{{visibleMessages.length === 0}}">
      <view class="message-empty-icon">
        <image src="/images/icon-profile-bell.svg" mode="aspectFit"></image>
      </view>
      <view class="message-empty-title">暂无{{activeFilter === 'all' ? '消息' : (activeFilter === 'trip' ? '行程通知' : '互动消息')}}</view>
      <view class="message-empty-desc">有新动态时会第一时间通知你</view>
    </view>

    <view class="message-list" wx:else>
      <view class="message-row {{item.isTripApply && item.applyStatus === 'pending' ? 'message-apply-pending' : ''}}"
        wx:for="{{visibleMessages}}" wx:key="_id" bindtap="onMessageTap" data-index="{{index}}">
        <block wx:if="{{item.isTripApply}}">
          <view class="message-avatar-wrap message-apply-avatar-wrap">
            <image class="message-avatar" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"></image>
            <view class="message-avatar message-avatar-fallback" wx:else>{{item.avatarText}}</view>
          </view>
          <view class="message-copy message-apply-copy">
            <view class="message-copy-head">
              <view class="message-headline">
                <text class="message-name">{{item.title}}</text>
              </view>
              <text class="message-time">{{item.timeText}}</text>
            </view>
            <view class="message-apply-title">申请加入「{{item.tripTitle}}」</view>
            <view class="message-apply-message" wx:if="{{item.applyMessage}}">{{item.applyMessage}}</view>
            <view class="message-apply-actions" wx:if="{{item.applyStatus === 'pending'}}">
              <view class="message-apply-btn message-apply-reject {{handlingApplyId === item.applyId ? 'message-apply-disabled' : ''}}"
                catchtap="onApplyAction" data-index="{{index}}" data-accept="false">拒绝</view>
              <view class="message-apply-btn message-apply-agree {{handlingApplyId === item.applyId ? 'message-apply-disabled' : ''}}"
                catchtap="onApplyAction" data-index="{{index}}" data-accept="true">同意</view>
            </view>
            <view class="message-apply-status message-apply-status-accepted" wx:elif="{{item.applyStatus === 'accepted'}}">已同意</view>
            <view class="message-apply-status" wx:elif="{{item.applyStatus === 'rejected'}}">已拒绝</view>
            <view class="message-apply-status" wx:else>已失效</view>
          </view>
        </block>

        <block wx:else>
          <view class="message-avatar-wrap">
            <image class="message-avatar" wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill"></image>
            <view class="message-avatar message-avatar-fallback" wx:else>
              <image wx:if="{{item.category === 'trip'}}" src="/images/icon-profile-calendar.svg" mode="aspectFit"></image>
              <text wx:else>{{item.avatarText}}</text>
            </view>
          </view>

          <view class="message-copy">
            <view class="message-copy-head">
              <view class="message-headline">
                <text class="message-name">{{item.title}}</text>
                <text class="message-action">{{item.actionText}}</text>
              </view>
              <text class="message-time">{{item.timeText}}</text>
            </view>
            <view class="message-preview">{{item.preview}}</view>
          </view>

          <image class="message-source-thumb" wx:if="{{item.thumbnail}}" src="{{item.thumbnail}}" mode="aspectFill"></image>
        </block>
        <view class="message-unread-dot" wx:if="{{item.unread}}"></view>
      </view>
    </view>
    <view class="message-load-more" wx:if="{{loadingMore}}">加载中...</view>
    <view class="message-load-more" wx:if="{{!loading && !loadingMore && visibleMessages.length > 0 && !hasMore}}">— 没有更多了 —</view>
    <view class="message-safe-bottom"></view>
  </block>
</view>

<!-- 行程申请完整留言 -->
<view class="message-apply-modal-mask" wx:if="{{showApplyMessageModal}}" bindtap="onCloseApplyMessage">
  <view class="message-apply-modal" catchtap>
    <view class="message-apply-modal-handle"></view>
    <view class="message-apply-modal-head">
      <view class="message-apply-modal-title">申请详情</view>
      <view class="message-apply-modal-close" bindtap="onCloseApplyMessage">
        <image src="/images/icon-close-gray.png" mode="aspectFit"></image>
      </view>
    </view>
    <view class="message-apply-modal-user">
      <image class="message-apply-modal-avatar" wx:if="{{selectedApplyMessage.avatar}}"
        src="{{selectedApplyMessage.avatar}}" mode="aspectFill"></image>
      <view class="message-apply-modal-avatar message-avatar-fallback" wx:else>{{selectedApplyMessage.avatarText}}</view>
      <view class="message-apply-modal-user-copy">
        <view class="message-apply-modal-name">{{selectedApplyMessage.title}}</view>
        <view class="message-apply-modal-trip">申请加入「{{selectedApplyMessage.tripTitle}}」</view>
      </view>
    </view>
    <view class="message-apply-modal-divider"></view>
    <view class="message-apply-modal-label">留言</view>
    <view class="message-apply-modal-content {{selectedApplyMessage.applyMessage ? '' : 'message-apply-modal-empty'}}">
      {{selectedApplyMessage.applyMessage || '申请人未填写留言'}}
    </view>
    <view class="message-apply-modal-actions" wx:if="{{selectedApplyMessage.applyStatus === 'pending'}}">
      <view class="message-apply-modal-btn message-apply-modal-reject" catchtap="onApplyModalAction"
        data-index="{{selectedApplyIndex}}" data-accept="false">拒绝</view>
      <view class="message-apply-modal-btn message-apply-modal-agree" catchtap="onApplyModalAction"
        data-index="{{selectedApplyIndex}}" data-accept="true">同意申请</view>
    </view>
    <view class="message-apply-modal-status" wx:elif="{{selectedApplyMessage.applyStatus === 'accepted'}}">该申请已同意</view>
    <view class="message-apply-modal-status" wx:elif="{{selectedApplyMessage.applyStatus === 'rejected'}}">该申请已拒绝</view>
  </view>
</view>
