page {
  min-height: 100%;
  background: #fff;
}

.likes-page {
  min-height: 100vh;
  background: #fff;
}

.state {
  min-height: 64vh;
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8390A6;
  font-size: 26rpx;
}

.spinner {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 18rpx;
  border: 4rpx solid #E8ECF2;
  border-top-color: #4A90E2;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.state-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
}

.state-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.retry {
  margin-top: 22rpx;
  color: #4A90E2;
}

.likes-list {
  padding: 0 32rpx;
}

.like-user {
  min-height: 124rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #E8ECF2;
}

.like-user:active {
  opacity: .65;
}

.user-avatar {
  width: 84rpx;
  height: 84rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #F4F6F9;
}

.user-info {
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex: 1;
  flex-direction: column;
}

.user-name {
  overflow: hidden;
  color: #111827;
  font-size: 29rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.like-label {
  margin-top: 6rpx;
  color: #8390A6;
  font-size: 23rpx;
}

.list-status {
  padding: 30rpx 0 calc(30rpx + env(safe-area-inset-bottom));
  color: #A2ABBB;
  font-size: 23rpx;
  text-align: center;
}

.list-status.retry {
  color: #4A90E2;
}
