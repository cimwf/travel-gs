}

/* ========== 图片布局 ========== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}

.photo-grid-1 {
  width: 100%;
}

.photo-grid-2 {
  width: 100%;
}

.photo-grid-3 {
  width: 100%;
}

.photo-item {
  width: 320rpx;
  height: 320rpx;
  border-radius: 12rpx;
  background: #eef2f7;
  display: block;
}

.photo-single-wrap {
  width: 100%;
  max-height: 600rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: #eef2f7;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}

.photo-item-single {
  width: 100%;
  display: block;
}

.photo-grid-2 .photo-item {
  width: calc((100% - 8rpx) / 2);
  height: 260rpx;
}

.photo-grid-3 .photo-item {
  width: calc((100% - 16rpx) / 3);
  height: 220rpx;
}

/* ========== 发布日志弹窗 ========== */
.publish-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.publish-modal {
  width: 100%;
  background: white;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  max-height: 85vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.publish-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 28rpx;
  text-align: center;
}

.publish-textarea {
  width: 100%;
  min-height: 180rpx;
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.7;
  padding: 20rpx;
  background: var(--bg-color);
  border-radius: 16rpx;
  box-sizing: border-box;
}

.publish-char-count {
  text-align: right;
  font-size: 24rpx;
  color: var(--text-hint);
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}

.publish-location-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.publish-location-trigger {
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #f4f8ff;
  color: #4f79b8;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.publish-location-label {
  line-height: 1;
}

.publish-location-chip {
  min-width: 0;
  max-width: 100%;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.publish-location-chip-main {
  min-width: 0;
  max-width: 520rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #eef3fb;
  color: #5f6f89;
  display: flex;
  align-items: center;
}

.publish-location-chip-text {
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.publish-location-chip-remove {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.08);
  color: #7f8897;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-images {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 12rpx;
}

.publish-image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.publish-image-preview {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--bg-color);
}

.publish-image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-add-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: var(--bg-color);
  border: 3rpx dashed var(--border-color);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.publish-add-icon {
  font-size: 52rpx;
  color: var(--text-hint);
  line-height: 1;
}

.publish-add-text {
  font-size: 22rpx;
  color: var(--text-hint);
}

.publish-image-count {
  margin-bottom: 32rpx;
  text-align: right;
  font-size: 22rpx;
  color: #a3acba;
}

.publish-modal-actions {
  display: flex;
  gap: 24rpx;
}

.publish-btn-cancel {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
  color: var(--text-secondary);
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.publish-btn-submit {
  flex: 1.4;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #5fb266;
  color: #fff;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.publish-btn-disabled {
  opacity: 0.6;
}

/* ========== 已结束 / 进行中 footer 按钮 ========== */
.footer-btn-ended {
  background: var(--bg-color);
  color: var(--text-hint);
  border-radius: 32rpx;
  box-shadow: none;
}

.footer-btn-ongoing {
  background: var(--bg-color);
  color: var(--text-secondary);
  border-radius: 32rpx;
  box-shadow: none;
}

/* ========== 更换图片按钮 ========== */
.change-cover-btn {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(10px);
  padding: 16rpx 20rpx;
  border-radius: 24rpx;
}

.change-cover-icon {
  font-size: 36rpx;
  line-height: 1;
}

.change-cover-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 500;
  white-space: nowrap;
}

/* ========== 更换图片底部弹窗 ========== */
.cover-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.cover-modal {
  width: 100%;
  background: white;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 80vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.cover-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.cover-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.cover-modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--bg-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-modal-close-icon {
  font-size: 36rpx;
  color: var(--text-hint);
  line-height: 1;
}

/* ---- 分区 ---- */
.cover-section {
  margin-bottom: 36rpx;
}

.cover-section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-hint);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cover-count {
  font-weight: 400;
  font-size: 24rpx;
}

/* ---- 行程头像 ---- */
.cover-avatar-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.cover-avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: var(--bg-color);
  flex-shrink: 0;
}

.cover-avatar-img {
  width: 140rpx;
  height: 140rpx;
  display: block;
}

.cover-avatar-empty {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-avatar-empty-icon {
  font-size: 52rpx;
}

.cover-avatar-btns {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.cover-avatar-btn-upload {
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.cover-avatar-btn-del {
  height: 72rpx;
  padding: 0 36rpx;
  border-radius: 20rpx;
  background: rgba(255, 77, 79, 0.08);
  color: #FF4D4F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

/* ---- 封面图网格 ---- */
.cover-images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cover-img-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
}

.cover-img-preview {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  display: block;
  background: var(--bg-color);
}

.cover-img-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.cover-img-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: var(--bg-color);
  border: 3rpx dashed var(--border-color);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-img-add-icon {
  font-size: 60rpx;
  color: var(--text-hint);
  line-height: 1;
}

/* ---- 底部操作按钮 ---- */
.cover-modal-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.cover-btn-cancel {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-color);
  color: var(--text-secondary);
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.cover-btn-save {
  flex: 1.4;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  color: white;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 226, 0.3);
}

.cover-btn-disabled {
  opacity: 0.6;
}

/* ========== 授权相关按钮 ========== */
.modal-btn-green {
  background: #edf7eb;
  color: #5fb266;
}

.modal-btn-secondary {
  background: var(--bg-color);
  color: var(--text-secondary);
}

/* ========== 日志操作菜单 ========== */
.log-menu-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.log-menu-sheet {
  width: 100%;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.log-menu-group {
  background: white;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.log-menu-item {
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--text-primary);
  background: white;
}

.log-menu-group .log-menu-item + .log-menu-item {
  border-top: 2rpx solid var(--bg-color);
}

.log-menu-item-danger {
  color: #FF4D4F;
}

.log-menu-cancel {
  border-radius: 24rpx;
  color: var(--text-hint);
  font-weight: 500;
}

@keyframes skeleton-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

