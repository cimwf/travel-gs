<!--pages/trip-detail/trip-detail.wxml-->
<view class="detail-v2-page">
  <block wx:if="{{trip}}">
    <swiper class="detail-v2-hero" indicator-dots="{{trip.placeCoverImages.length > 1}}" indicator-color="rgba(255,255,255,.55)" indicator-active-color="#ffffff" autoplay="{{trip.placeCoverImages.length > 1}}" interval="4500" circular="{{trip.placeCoverImages.length > 1}}">
      <swiper-item wx:for="{{trip.placeCoverImages}}" wx:key="*this">
        <image class="detail-v2-hero-image" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>

    <view class="detail-v2-overview">
      <view class="detail-v2-title-line">
        <view class="detail-v2-title">{{trip.tripTitle || trip.placeName}}</view>
        <view class="detail-v2-status detail-v2-status-{{trip.status}}" wx:if="{{!hasJoined || isCreator}}">{{statusText}}</view>
        <view class="detail-v2-status detail-v2-status-joined" wx:else>已加入</view>
      </view>
      <view class="detail-v2-destination">{{trip.placeName}} · {{trip.placeHighlight || '北京周边'}}</view>
      <view class="detail-v2-quick-row">
        <image class="detail-v2-quick-icon" src="/images/icon-profile-calendar.svg" mode="aspectFit"></image>
        <text>{{trip.dateText || trip.date}}{{trip.meetingTime ? ' ' + trip.meetingTime + ' 出发' : ''}}</text>
      </view>
      <view class="detail-v2-quick-row" wx:if="{{trip.meetingPlace || trip.departure}}">
        <image class="detail-v2-quick-icon" src="/images/icon-profile-location.svg" mode="aspectFit"></image>
        <text>{{trip.meetingPlace || trip.departure}}</text>
      </view>
      <view class="detail-v2-people-row">
        <view class="detail-v2-avatar-stack">
          <block wx:for="{{participants}}" wx:key="userId">
            <image class="detail-v2-stack-avatar" wx:if="{{index < 4 && item.avatar}}" src="{{item.avatar}}" mode="aspectFill"></image>
            <view class="detail-v2-stack-avatar detail-v2-stack-text" wx:elif="{{index < 4}}">{{item.nickname ? item.nickname[0] : '旅'}}</view>
          </block>
        </view>
        <text class="detail-v2-people-count">已加入 {{trip.currentCount}}/{{trip.totalCount || (trip.currentCount + trip.needCount)}} 人</text>
        <view class="detail-v2-change-cover" wx:if="{{isCreator}}" bindtap="onOpenCoverModal">
          <image src="/images/icon-camera-blue.png" mode="aspectFit"></image>
          <text>更换封面</text>
        </view>
      </view>
    </view>

    <view class="detail-v2-tabs" wx:if="{{showTabs}}">
      <view class="detail-v2-tab {{activeTab === 'trip' ? 'detail-v2-tab-active' : ''}}" bindtap="onSwitchTab" data-tab="trip">行程</view>
      <view class="detail-v2-tab {{activeTab === 'log' ? 'detail-v2-tab-active' : ''}}" bindtap="onSwitchTab" data-tab="log">旅途记录</view>
      <view class="detail-v2-tab {{activeTab === 'comment' ? 'detail-v2-tab-active' : ''}}" bindtap="onSwitchTab" data-tab="comment">评论{{trip.commentCount ? ' ' + trip.commentCount : ''}}</view>
    </view>

    <view class="detail-v2-content">
      <block wx:if="{{activeTab === 'trip'}}">
        <view class="detail-v2-section" wx:if="{{trip.remark}}">
          <view class="detail-v2-section-title">行程说明</view>
          <view class="detail-v2-note">{{trip.remark}}</view>
        </view>

        <view class="detail-v2-section">
          <view class="detail-v2-section-title">行程信息</view>
          <view class="detail-v2-info-list">
            <view class="detail-v2-info-row">
              <text class="detail-v2-info-label">出发日期</text>
              <text class="detail-v2-info-value">{{trip.dateText || trip.date}}</text>
            </view>
            <view class="detail-v2-info-row">
              <text class="detail-v2-info-label">出发地</text>
              <text class="detail-v2-info-value">{{trip.departure || '待定'}}</text>
            </view>
            <view class="detail-v2-info-row" wx:if="{{trip.meetingPlace}}">
              <text class="detail-v2-info-label">集合地点</text>
              <text class="detail-v2-info-value">{{trip.meetingPlace}}</text>
            </view>
            <view class="detail-v2-info-row detail-v2-info-row-link" wx:if="{{trip.destLocation}}" bindtap="onOpenDestLocation">
              <text class="detail-v2-info-label">目的地定位</text>
              <view class="detail-v2-info-value detail-v2-location-value">
                <text>{{trip.destLocation.name || trip.destLocation.address}}</text>
                <text class="detail-v2-chevron">›</text>
              </view>
            </view>
            <view class="detail-v2-info-row" wx:if="{{trip.meetingTime}}">
              <text class="detail-v2-info-label">集合时间</text>
              <text class="detail-v2-info-value">{{trip.meetingTime}}</text>
            </view>
            <view class="detail-v2-info-row">
              <text class="detail-v2-info-label">出行方式</text>
              <text class="detail-v2-info-value">{{trip.hasCar ? '有车' : '无车'}}</text>
            </view>
            <view class="detail-v2-info-row" wx:if="{{trip.hasCar && (trip.carSeats || trip.carModel)}}">
              <text class="detail-v2-info-label">车辆信息</text>
              <text class="detail-v2-info-value">{{trip.carSeats ? trip.carSeats + '座' : ''}}{{trip.carSeats && trip.carModel ? ' · ' : ''}}{{trip.carModel || ''}}</text>
            </view>
            <view class="detail-v2-info-row" wx:if="{{!trip.hasCar && trip.travelDesc}}">
              <text class="detail-v2-info-label">出行描述</text>
              <text class="detail-v2-info-value">{{trip.travelDesc}}</text>
            </view>
            <view class="detail-v2-info-row" wx:if="{{trip.price}}">
              <text class="detail-v2-info-label">人均费用</text>
              <text class="detail-v2-info-value detail-v2-price">{{trip.price}}元/人</text>
            </view>
            <view class="detail-v2-info-row">
              <text class="detail-v2-info-label">招募人数</text>
              <text class="detail-v2-info-value">{{trip.currentCount}}/{{trip.totalCount || (trip.currentCount + trip.needCount)}}人</text>
            </view>
          </view>
        </view>

        <view class="detail-v2-section">
          <view class="detail-v2-members-head">
            <view class="detail-v2-section-title">已加入成员</view>
            <text>{{trip.currentCount}}/{{trip.totalCount || (trip.currentCount + trip.needCount)}}人</text>
          </view>
          <view class="detail-v2-members-grid">
            <view class="detail-v2-member" wx:for="{{participants}}" wx:key="userId" bindtap="onMemberTap" data-member="{{item}}">
              <image class="detail-v2-member-avatar" src="{{item.avatar}}" wx:if="{{item.avatar}}" mode="aspectFill"></image>
              <view class="detail-v2-member-avatar detail-v2-member-text" wx:else>{{item.nickname ? item.nickname[0] : '旅'}}</view>
              <view class="detail-v2-member-name">{{item.nickname || '旅行者'}}</view>
            </view>
            <view class="detail-v2-member detail-v2-member-placeholder" wx:for="{{remainCount}}" wx:key="index">
              <view class="detail-v2-member-avatar detail-v2-placeholder-avatar">+</view>
              <view class="detail-v2-member-name">待加入</view>
            </view>
          </view>
        </view>
      </block>

      <block wx:if="{{activeTab === 'log'}}">
        <view class="detail-v2-log-head">
          <view>
            <view class="detail-v2-section-title">旅途记录</view>
            <view class="detail-v2-log-subtitle">记录旅途中闪亮的美好瞬间</view>
          </view>
          <view class="detail-v2-record-btn" wx:if="{{canPublishLog}}" bindtap="onPublishLogTap">
            <image src="/images/icon-plus-blue.png" mode="aspectFit"></image>
            <text>记录此刻</text>
          </view>
        </view>

        <view class="detail-v2-log-notice" wx:if="{{tripStage === 'ongoing'}}">行程日志已开启，同行成员可以共同记录这段旅程。</view>

        <view class="detail-v2-log-empty" wx:if="{{logGroups.length === 0}}">
          <view wx:if="{{canPublishLog}}">还没有记录，点击「记录此刻」发布第一条吧。</view>
          <view wx:else>暂无旅途记录。</view>
        </view>

        <view class="detail-v2-log-group" wx:for="{{logGroups}}" wx:key="dayLabel" wx:for-item="group" wx:for-index="groupIndex">
          <view class="detail-v2-day-head">
            <view class="detail-v2-day-title">{{group.dayLabel}} · 第{{group.tripDayIndex}}天</view>
            <view class="detail-v2-weather" wx:if="{{group.weatherLabel}}">{{group.weatherLabel}}</view>
          </view>
          <view class="detail-v2-log-entry" wx:for="{{group.logs}}" wx:key="_id" wx:for-item="log" wx:for-index="logIndex">
            <view class="detail-v2-log-meta">
              <image class="detail-v2-log-avatar" src="{{log.publisherAvatar}}" wx:if="{{log.publisherAvatar}}" mode="aspectFill"></image>
              <view class="detail-v2-log-avatar detail-v2-log-avatar-text" wx:else>{{log.publisherName ? log.publisherName[0] : '旅'}}</view>
              <view class="detail-v2-log-author">
                <view>{{log.publisherName || '旅行者'}}</view>
                <view class="detail-v2-log-time-row">
                  <text>{{log.timeText}}</text>
                  <text class="detail-v2-log-review-status" wx:if="{{log.isPublisher && log.reviewStatusText}}">· {{log.reviewStatusText}}</text>
                </view>
              </view>
              <view class="detail-v2-log-menu" wx:if="{{isCreator || !log.isPublisher}}" catchtap="onLogMenuTap" data-group-index="{{groupIndex}}" data-log-index="{{logIndex}}" data-log-id="{{log._id}}" data-can-delete="{{isCreator}}" data-is-publisher="{{log.isPublisher}}">
                <image src="/images/icon-more-gray.png" mode="aspectFit"></image>
              </view>
            </view>
            <view class="detail-v2-log-text" wx:if="{{log.content}}">{{log.content}}</view>
            <view wx:if="{{log.images && log.images.length > 0}}">
              <view class="photo-grid {{log.imageGridClass}}">
                <block wx:if="{{log.imageCount === 1}}">
                  <view class="photo-single-wrap" bindtap="onPreviewImage" data-urls="{{log.imageUrls}}" data-current="{{log.images[0].url || log.images[0].tempFileURL || log.images[0].fileID}}">
                    <image class="photo-item-single" src="{{log.images[0].url || log.images[0].tempFileURL || log.images[0].fileID}}" mode="widthFix"></image>
                  </view>
                </block>
                <block wx:else>
                  <image class="photo-item" wx:for="{{log.renderImages}}" wx:key="sort" src="{{item.url || item.tempFileURL || item.fileID}}" mode="aspectFill" bindtap="onPreviewImage" data-urls="{{log.imageUrls}}" data-current="{{item.url || item.tempFileURL || item.fileID}}"></image>
                </block>
              </view>
            </view>
            <view class="detail-v2-log-location" wx:if="{{log.locationText}}" bindtap="onOpenLogLocation" data-latitude="{{log.location.latitude}}" data-longitude="{{log.location.longitude}}" data-name="{{log.location.name}}" data-address="{{log.location.address}}">
              <image src="/images/icon-location-blue.png" mode="aspectFit"></image>
              <text>{{log.locationText}}</text>
            </view>
          </view>
        </view>
      </block>

      <block wx:if="{{activeTab === 'comment'}}">
        <view class="detail-v2-comment-section">
          <view class="detail-v2-comment-head">
            <view class="detail-v2-section-title">全部评论</view>
            <text>{{trip.commentCount || 0}}条</text>
          </view>

          <view class="detail-v2-comment-list" wx:if="{{comments.length > 0}}">
            <view class="detail-v2-comment-thread" wx:for="{{comments}}" wx:key="_id">
              <view class="detail-v2-comment-item" bindlongpress="onCommentLongPress"
                data-comment-id="{{item._id}}" data-target-type="comment" data-root-comment-id="{{item._id}}">
                <image class="detail-v2-comment-avatar" src="{{item.authorAvatar}}" wx:if="{{item.authorAvatar}}"
                  mode="aspectFill" catchtap="onCommentAuthorTap" data-user-id="{{item.authorId}}"></image>
                <view class="detail-v2-comment-avatar detail-v2-comment-avatar-text" wx:else
                  catchtap="onCommentAuthorTap" data-user-id="{{item.authorId}}">{{item.authorName ? item.authorName[0] : '旅'}}</view>
                <view class="detail-v2-comment-main">
                  <view class="detail-v2-comment-author" catchtap="onCommentAuthorTap" data-user-id="{{item.authorId}}">{{item.authorName || '旅行者'}}</view>
                  <view class="detail-v2-comment-content">{{item.content}}</view>
                  <view class="detail-v2-comment-footer">
                    <text class="detail-v2-comment-time">{{item.timeText}}</text>
                    <text class="detail-v2-comment-reply" catchtap="onReplyTap"
                      data-target-id="{{item._id}}" data-target-type="comment"
                      data-root-comment-id="{{item._id}}" data-user-name="{{item.authorName}}">回复</text>
                  </view>
                </view>
              </view>

              <view class="detail-v2-reply-list" wx:if="{{item.replies.length > 0}}">
                <view class="detail-v2-reply-item" wx:for="{{item.replies}}" wx:key="_id" wx:for-item="reply"
                  bindlongpress="onCommentLongPress" data-comment-id="{{reply._id}}" data-target-type="reply"
                  data-root-comment-id="{{item._id}}">
                  <image class="detail-v2-reply-avatar" src="{{reply.authorAvatar}}" wx:if="{{reply.authorAvatar}}"
                    mode="aspectFill" catchtap="onCommentAuthorTap" data-user-id="{{reply.authorId}}"></image>
                  <view class="detail-v2-reply-avatar detail-v2-comment-avatar-text" wx:else
                    catchtap="onCommentAuthorTap" data-user-id="{{reply.authorId}}">{{reply.authorName ? reply.authorName[0] : '旅'}}</view>
                  <view class="detail-v2-reply-main">
                    <view class="detail-v2-reply-content">
                      <text class="detail-v2-reply-author">{{reply.authorName || '旅行者'}}</text>
                      <text class="detail-v2-reply-word"> 回复 </text>
                      <text class="detail-v2-reply-target">{{reply.replyToUserName || '旅行者'}}</text>
                      <text>：{{reply.content}}</text>
                    </view>
                    <view class="detail-v2-comment-footer">
                      <text class="detail-v2-comment-time">{{reply.timeText}}</text>
                      <text class="detail-v2-comment-reply" catchtap="onReplyTap"
                        data-target-id="{{reply._id}}" data-target-type="reply"
                        data-root-comment-id="{{item._id}}" data-user-name="{{reply.authorName}}">回复</text>
                    </view>
                  </view>
                </view>
              </view>
              <view class="detail-v2-reply-more" wx:if="{{item.repliesLoading}}">回复加载中...</view>
              <view class="detail-v2-reply-more" wx:elif="{{item.repliesHasMore || item.replyCount > item.replies.length}}"
                catchtap="onLoadMoreReplies" data-root-comment-id="{{item._id}}">展开更多回复</view>
            </view>
          </view>

          <view class="detail-v2-comments-empty" wx:elif="{{!commentsLoading && !commentsError}}">
            <view class="detail-v2-comments-empty-title">还没有评论</view>
            <view class="detail-v2-comments-empty-desc">来聊聊这次出行吧～</view>
          </view>
          <view class="detail-v2-comments-status" wx:if="{{commentsLoading}}">评论加载中...</view>
          <view class="detail-v2-comments-status detail-v2-comments-link" wx:elif="{{commentsError}}" bindtap="onLoadMoreComments">评论加载失败，点击重试</view>
          <view class="detail-v2-comments-status detail-v2-comments-link" wx:elif="{{commentsHasMore}}" bindtap="onLoadMoreComments">查看更多评论</view>
        </view>
      </block>
    </view>
    <view class="detail-v2-safe-bottom"></view>
  </block>
  <view class="detail-load-error" wx:elif="{{loadError}}">
    <image class="detail-load-error-icon" src="/images/icon-profile-info.svg" mode="aspectFit"></image>
    <view class="detail-load-error-title">行程加载失败</view>
    <view class="detail-load-error-desc">请检查网络后重新尝试</view>
    <view class="detail-load-error-btn" bindtap="onRetryTripDetail">重新加载</view>
  </view>
</view>

<!-- 底部按钮区域 -->
<view class="footer-bar detail-v2-footer" wx:if="{{trip}}">
  <block wx:if="{{activeTab === 'comment'}}">
    <input class="detail-v2-comment-input" value="{{commentDraft}}" placeholder="{{commentPlaceholder}}"
      maxlength="300" confirm-type="send" focus="{{inputFocused}}" disabled="{{submittingComment}}"
      bindtap="onCommentInputTap" bindinput="onCommentInput" bindfocus="onCommentFocus"
      bindblur="onCommentBlur" bindconfirm="onCommentConfirm"></input>
    <view class="detail-v2-footer-log" bindtap="onPublishLogTap">
      <image src="/images/icon-plus-blue.png" mode="aspectFit"></image>
      <text>发布日志</text>
    </view>
  </block>
  <block wx:elif="{{activeTab === 'log'}}">
    <view class="footer-btn-full detail-v2-log-footer-btn" bindtap="onPublishLogTap">发布日志</view>
  </block>
  <!-- 发起人视角 -->
  <block wx:elif="{{isCreator}}">
    <!-- 未开始：编辑行程 + 开始出发（仅行程当天显示） -->
    <block wx:if="{{tripStage === 'not_started'}}">
      <view class="footer-btn-secondary" bindtap="onEditTrip">编辑行程</view>
      <view class="footer-btn-primary" wx:if="{{isTripDay}}" bindtap="onStartLog">开始出发</view>
      <button class="footer-btn-primary" wx:else open-type="share">分享招募</button>
    </block>
    <!-- 进行中：发布日志 + 结束行程 -->
    <block wx:elif="{{tripStage === 'ongoing'}}">
      <view class="footer-btn-secondary" bindtap="onPublishLogTap">发布日志</view>
      <view class="footer-btn-danger" bindtap="onEndLog">结束行程</view>
    </block>
    <!-- 已结束 -->
    <block wx:else>
      <view class="footer-btn-full footer-btn-ended">已结束</view>
    </block>
  </block>

  <!-- 已加入成员视角（非发起人） -->
  <block wx:elif="{{hasJoined}}">
    <!-- 进行中且有发布权限 -->
    <block wx:if="{{tripStage === 'ongoing' && canPublishLog}}">
      <view class="footer-btn-secondary" bindtap="onPublishLogTap">发布日志</view>
    </block>
    <!-- 进行中无权限 -->
    <block wx:elif="{{tripStage === 'ongoing'}}">
      <view class="footer-btn-full footer-btn-ongoing">进行中</view>
    </block>
    <!-- 未开始：退出行程 + 分享 -->
    <block wx:elif="{{tripStage === 'not_started'}}">
      <view class="footer-btn-danger" bindtap="onQuitTrip">退出行程</view>
      <button class="footer-btn-primary" open-type="share">分享给朋友</button>
    </block>
    <!-- 已结束 -->
    <block wx:else>
      <view class="footer-btn-full footer-btn-ended">已结束</view>
    </block>
  </block>

  <!-- 未加入视角：申请加入 -->
  <block wx:else>
    <view class="footer-btn-full {{canJoin ? '' : 'disabled'}}" bindtap="onJoinTap">
      <text>{{joinBtnText}}</text>
    </view>
  </block>
</view>

<!-- 发布日志弹窗 -->
<view class="publish-modal-mask detail-v2-publish-mask" wx:if="{{showPublishModal}}" bindtap="onClosePublishModal">
  <view class="publish-modal detail-v2-publish-sheet" catchtap>
    <view class="detail-v2-publish-head">
      <view>
        <view class="publish-modal-title">记录此刻</view>
        <view class="detail-v2-publish-subtitle">分享旅途中的精彩瞬间</view>
      </view>
      <view class="detail-v2-publish-close" bindtap="onClosePublishModal">
        <image src="/images/icon-close-gray.png" mode="aspectFit"></image>
      </view>
    </view>
    <textarea class="publish-textarea" placeholder="分享旅途中的精彩瞬间（1-200字）" value="{{publishContent}}" bindinput="onPublishContentInput" maxlength="200" auto-height></textarea>
    <view class="publish-char-count">{{publishContent.length}}/200</view>

    <view class="publish-location-row">
      <view class="publish-location-trigger" bindtap="onChoosePublishLocation">
        <image class="publish-location-icon" src="/images/icon-location-blue.png" mode="aspectFit"></image>
        <text class="publish-location-label">{{publishLocation ? '更换定位' : '添加定位'}}</text>
      </view>
      <view class="publish-location-chip" wx:if="{{publishLocation}}">
        <view class="publish-location-chip-main" bindtap="onChoosePublishLocation">
          <text class="publish-location-chip-text">{{publishLocation.name || publishLocation.address}}</text>
        </view>
        <view class="publish-location-chip-remove" bindtap="onRemovePublishLocation">×</view>
      </view>
    </view>

    <!-- 图片上传区 -->
    <view class="publish-images">
      <view class="publish-image-item" wx:for="{{publishImages}}" wx:key="index">
        <image class="publish-image-preview" src="{{item.tempUrl}}" mode="aspectFill"></image>
        <view class="publish-image-remove" bindtap="onRemovePublishImage" data-index="{{index}}">
          <image src="/images/icon-close-white.png" mode="aspectFit"></image>
        </view>
      </view>
      <view class="publish-add-image" wx:if="{{publishImages.length < 9}}" bindtap="onChooseImage">
        <image class="publish-add-icon" src="/images/icon-plus-blue.png" mode="aspectFit"></image>
        <text class="publish-add-text">添加图片</text>
      </view>
    </view>
    <view class="publish-image-count">{{publishImages.length}}/9</view>

    <view class="publish-modal-actions">
      <view class="publish-btn-cancel" bindtap="onClosePublishModal">取消</view>
      <view class="publish-btn-submit {{publishSubmitting ? 'publish-btn-disabled' : ''}}" bindtap="onSubmitLog">{{publishSubmitting ? '发布中...' : '发布'}}</view>
    </view>
  </view>
</view>

<!-- 成员管理弹窗 -->
<view class="member-modal-mask" wx:if="{{showMemberModal}}" bindtap="onCloseMemberModal">
  <view class="member-modal" catchtap>
    <!-- 关闭按钮 -->
    <view class="modal-close-btn" bindtap="onCloseMemberModal">
      <text class="modal-close-icon">×</text>
    </view>

    <!-- 成员信息 -->
    <view class="modal-member-info">
      <image class="modal-avatar" src="{{selectedMember.avatar}}" wx:if="{{selectedMember.avatar}}" mode="aspectFill"></image>
      <view class="modal-avatar-text" style="background: linear-gradient(135deg, #56AB2F, #A8E6CF);" wx:else>
        <text>{{selectedMember.nickname ? selectedMember.nickname[0] : '旅'}}</text>
      </view>
      <view class="modal-name">{{selectedMember.nickname || '旅行者'}}</view>
    </view>

    <!-- 操作按钮 -->
    <view class="modal-actions">
      <view class="modal-btn modal-btn-primary" bindtap="onViewProfile">查看资料</view>
      <view class="modal-btn modal-btn-danger" wx:if="{{isCreator && selectedMember.userId !== trip.creatorId && tripStage === 'not_started'}}" bindtap="onRemoveMember">移除成员</view>
      <!-- 授权/取消授权 -->
      <block wx:if="{{isCreator && selectedMember.userId !== trip.creatorId && tripStage === 'ongoing'}}">
        <view class="modal-btn modal-btn-green" wx:if="{{!selectedMemberAuthorized}}" bindtap="onAuthorizePublisher">授权发布日志</view>
        <view class="modal-btn modal-btn-secondary" wx:else bindtap="onUnauthorizePublisher">取消发布授权</view>
      </block>
    </view>
  </view>
</view>

<!-- 更换图片底部弹窗 -->
<view class="cover-modal-mask" wx:if="{{showCoverModal}}" bindtap="onCloseCoverModal">
  <view class="cover-modal" catchtap>
    <!-- 顶部标题栏 -->
    <view class="cover-modal-header">
      <text class="cover-modal-title">更换封面</text>
      <view class="cover-modal-close" bindtap="onCloseCoverModal">
        <text class="cover-modal-close-icon">×</text>
      </view>
    </view>

    <!-- 封面图数组 -->
    <view class="cover-section">
      <view class="cover-section-label">封面图片 <text class="cover-count">{{pendingImages.length}}/9</text></view>
      <view class="cover-images-grid">
        <view class="cover-img-item" wx:for="{{pendingImages}}" wx:key="index" wx:for-index="idx">
          <image class="cover-img-preview" src="{{item.url}}" mode="aspectFill"></image>
          <view class="cover-img-delete" catchtap="onRemoveCoverImage" data-index="{{idx}}">×</view>
        </view>
        <view class="cover-img-add" wx:if="{{pendingImages.length < 9}}" bindtap="onAddCoverImages">
          <text class="cover-img-add-icon">+</text>
        </view>
      </view>
    </view>

    <!-- 底部操作按钮 -->
    <view class="cover-modal-actions">
      <view class="cover-btn-cancel" bindtap="onCloseCoverModal">取消</view>
      <view class="cover-btn-save {{savingCover ? 'cover-btn-disabled' : ''}}" bindtap="onSaveCoverChanges">
        {{savingCover ? '保存中...' : '保存'}}
      </view>
    </view>
  </view>
</view>

<!-- 移除成员确认弹窗 -->
<view class="member-modal-mask" wx:if="{{showRemoveConfirm}}" bindtap="onCloseRemoveConfirm">
  <view class="confirm-modal" catchtap>
    <view class="confirm-icon-wrap">
      <text class="confirm-icon">✕</text>
    </view>
    <view class="confirm-title">确认移除成员？</view>
    <view class="confirm-desc">移除后，该成员将退出此行程，无法查看行程信息。此操作不可撤销。</view>
    <view class="confirm-actions">
      <view class="confirm-btn confirm-btn-cancel" bindtap="onCloseRemoveConfirm">取消</view>
      <view class="confirm-btn confirm-btn-danger" bindtap="onConfirmRemove">确认移除</view>
    </view>
  </view>
</view>

<!-- 日志操作菜单 -->
<view class="log-menu-mask" wx:if="{{showLogMenu}}" bindtap="onCloseLogMenu">
  <view class="log-menu-sheet" catchtap>
    <view class="log-menu-group">
      <view class="log-menu-item" wx:if="{{logMenuCanReport}}" bindtap="onLogMenuReport">举报</view>
      <view class="log-menu-item log-menu-item-danger" wx:if="{{logMenuCanDelete}}" bindtap="onLogMenuDelete">删除日志</view>
    </view>
    <view class="log-menu-item log-menu-cancel" bindtap="onCloseLogMenu">取消</view>
  </view>
</view>
