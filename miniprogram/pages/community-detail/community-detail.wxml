<view class="detail-page">
  <view class="status-state" wx:if="{{loading}}">
    <view class="spinner"></view>
    <text>加载中...</text>
  </view>

  <view class="status-state" wx:elif="{{error || !post}}">
    <text class="status-title">动态暂不可用</text>
    <text class="status-desc">{{errorMessage || '内容可能已删除或暂不可查看'}}</text>
    <view class="status-retry" bindtap="onRetryLoad">重新加载</view>
  </view>

  <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}"
    scroll-into-view="{{scrollIntoView}}" scroll-with-animation wx:else>
    <view class="post">
      <view class="post-header">
        <view class="author">
          <image class="avatar" src="{{post.authorAvatar || '/images/logo.png'}}" mode="aspectFill"
            catchtap="onOpenUserProfile" data-user-id="{{post.authorId}}"></image>
          <view class="author-meta">
            <text class="author-name">{{post.authorName || '旅行者'}}</text>
            <text class="post-time">{{post.timeText}}</text>
          </view>
        </view>
        <view class="more-btn" bindtap="onPostMoreTap" aria-label="更多操作">
          <image class="more-icon" src="/images/icon-more-gray.png" mode="aspectFit"></image>
        </view>
      </view>

      <view class="post-body" wx:if="{{post.content}}">
        <text class="post-text">{{post.content}}</text>
      </view>

      <view class="post-location" wx:if="{{post.hasLocation}}" bindtap="onOpenLocation">
        <image class="location-icon" src="/images/icon-location-blue.png" mode="aspectFit"></image>
        <text class="location-name">{{post.location.name}}</text>
      </view>

      <view class="post-images {{post.imageLayout}}" wx:if="{{post.images && post.images.length > 0}}">
        <image wx:for="{{post.images}}" wx:for-item="image" wx:key="key"
          class="post-image {{post.imageLayout === 'grid-1' ? 'image-large' : ''}}"
          src="{{image.url}}" mode="aspectFill"
          bindtap="onPreviewImage" data-urls="{{post.imageUrls}}" data-current="{{image.url}}">
        </image>
      </view>
    </view>

    <view class="section likes-section">
      <view class="section-header">
        <text class="section-title">{{post.likeCount || 0}}人赞过</text>
        <text class="section-link" wx:if="{{post.likeCount > 0}}" bindtap="onViewAllLikes">查看全部</text>
      </view>
      <scroll-view class="liker-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{likers.length > 0}}">
        <view class="liker-list">
          <view class="liker-item" wx:for="{{likers}}" wx:key="userId">
            <image class="liker-avatar" src="{{item.userAvatar || '/images/logo.png'}}" mode="aspectFill"
              catchtap="onOpenUserProfile" data-user-id="{{item.userId}}"></image>
          </view>
        </view>
      </scroll-view>
      <view class="section-empty" wx:else>
        {{likersLoading ? '点赞加载中...' : (post.likeCount > 0 ? '已有' + post.likeCount + '人点赞' : '还没有人点赞')}}
      </view>
    </view>

    <view class="section comments-section" id="comments-section">
      <view class="section-header">
        <text class="section-title">共{{post.commentCount || 0}}条评论</text>
      </view>
      <view class="comment-list" wx:if="{{comments.length > 0}}">
        <view class="comment-thread" wx:for="{{comments}}" wx:key="_id">
          <view class="comment-item"
            catchlongpress="onCommentLongPress"
            data-target-type="comment" data-root-comment-id="{{item._id}}"
            data-comment-id="{{item._id}}">
            <image class="comment-avatar" src="{{item.authorAvatar || '/images/logo.png'}}" mode="aspectFill"
              catchtap="onOpenUserProfile" data-user-id="{{item.authorId}}"></image>
            <view class="comment-main">
              <text class="comment-author">{{item.authorName || '旅行者'}}</text>
              <text class="comment-content">{{item.content}}</text>
              <view class="comment-footer">
                <text class="comment-time">{{item.timeText}}</text>
                <text class="comment-reply-btn" catchtap="onReplyTap"
                  data-target-id="{{item._id}}" data-target-type="comment"
                  data-root-comment-id="{{item._id}}" data-user-name="{{item.authorName}}">回复</text>
              </view>
            </view>
            <!-- 评论点赞暂不开放 -->
          </view>

          <view class="reply-list" wx:if="{{item.replies && item.replies.length > 0}}">
            <view class="reply-item" wx:for="{{item.replies}}" wx:for-item="reply" wx:key="_id"
              catchlongpress="onCommentLongPress"
              data-target-type="reply" data-root-comment-id="{{item._id}}"
              data-comment-id="{{reply._id}}">
              <image class="reply-avatar" src="{{reply.authorAvatar || '/images/logo.png'}}" mode="aspectFill"
                catchtap="onOpenUserProfile" data-user-id="{{reply.authorId}}"></image>
              <view class="reply-main">
                <view class="reply-content">
                  <text class="reply-author">{{reply.authorName || '旅行者'}}</text>
                  <text class="reply-word"> 回复 </text>
                  <text class="reply-target">{{reply.replyToUserName || '旅行者'}}</text>
                  <text class="reply-text">：{{reply.content}}</text>
                </view>
                <view class="reply-footer">
                  <text class="reply-time">{{reply.timeText}}</text>
                  <text class="comment-reply-btn" catchtap="onReplyTap"
                    data-target-id="{{reply._id}}" data-target-type="reply"
                    data-root-comment-id="{{item._id}}" data-user-name="{{reply.authorName}}">回复</text>
                </view>
              </view>
            </view>
          </view>

          <view class="reply-more" wx:if="{{item.repliesLoading}}">
            <text>回复加载中...</text>
          </view>
          <view class="reply-more" wx:elif="{{item.repliesHasMore || item.replyCount > item.replies.length}}"
            catchtap="onLoadMoreReplies" data-root-comment-id="{{item._id}}">
            <text>展开更多回复</text>
          </view>
        </view>
      </view>
      <view class="comments-empty" wx:else>
        <text class="empty-title">还没有评论</text>
        <text class="empty-desc">来聊聊这个话题吧～</text>
      </view>
      <view class="comments-status" wx:if="{{commentsLoading}}">
        <text>评论加载中...</text>
      </view>
      <view class="comments-status comments-retry" wx:elif="{{commentsError}}" bindtap="onLoadMoreComments">
        <text>评论加载失败，点击重试</text>
      </view>
      <view class="comments-status comments-more" wx:elif="{{commentsHasMore}}" bindtap="onLoadMoreComments">
        <text>查看更多评论</text>
      </view>
    </view>

    <view class="scroll-safe-area"></view>
  </scroll-view>

  <view class="interaction-bar" wx:if="{{post}}">
    <input class="comment-input" value="{{commentDraft}}" placeholder="{{commentPlaceholder}}"
      maxlength="300" confirm-type="send" focus="{{inputFocused}}"
      disabled="{{submittingComment}}"
      bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
      bindconfirm="onCommentConfirm"></input>
    <view class="interaction-action" bindtap="onLikeTap">
      <image class="interaction-icon"
        src="{{post.isLiked ? '/images/icon-like-heart-active.svg' : '/images/icon-like-heart-gray.svg'}}"
        mode="aspectFit"></image>
      <text class="interaction-count {{post.isLiked ? 'liked-count' : ''}}">{{post.likeCount || 0}}</text>
    </view>
    <view class="interaction-action" bindtap="onCommentTap">
      <image class="interaction-icon" src="/images/icon-comment-gray.svg" mode="aspectFit"></image>
      <text class="interaction-count">{{post.commentCount || 0}}</text>
    </view>
  </view>

  <view class="post-actions-mask" wx:if="{{showPostActions}}" catchtap="onClosePostActions">
    <view class="post-actions-panel" catchtap="onPostActionsPanelTap">
      <button class="post-action-item post-action-share" open-type="share"
        hover-class="post-action-hover" aria-label="分享动态">分享动态</button>
      <button class="post-action-item post-action-report" wx:if="{{!post.isAuthor}}"
        hover-class="post-action-hover" bindtap="onReportPostTap">举报</button>
      <button class="post-action-item post-action-delete" wx:if="{{post.isAuthor}}"
        hover-class="post-action-hover" bindtap="onDeletePostTap">删除动态</button>
      <view class="post-actions-gap"></view>
      <button class="post-action-item post-action-cancel" hover-class="post-action-hover"
        bindtap="onClosePostActions">取消</button>
    </view>
  </view>
</view>
