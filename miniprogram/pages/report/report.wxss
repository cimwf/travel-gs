page { height: 100%; background: #fff; color: #111827; }
.report-page { height: 100%; display: flex; flex-direction: column; background: #fff; }
.report-scroll { flex: 1; min-height: 0; }
.report-content { padding: 24rpx 36rpx 0; }
.report-tip { color: #71809a; font-size: 27rpx; line-height: 1.5; margin-bottom: 34rpx; }
.section-title { color: #111827; font-size: 30rpx; font-weight: 600; }
.reason-list { margin-top: 12rpx; border-top: 1rpx solid #e8edf3; }
.reason-row { height: 86rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 12rpx; border-bottom: 1rpx solid #e8edf3; font-size: 29rpx; }
.radio { width: 34rpx; height: 34rpx; border-radius: 50%; border: 3rpx solid #c8d0dc; display: flex; align-items: center; justify-content: center; box-sizing: border-box; }
.radio.selected { border-color: #2783ee; }
.radio-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: #2783ee; }
.field-head { display: flex; align-items: center; justify-content: space-between; margin-top: 42rpx; }
.description-box { height: 210rpx; margin-top: 18rpx; border: 1rpx solid #dce3ec; border-radius: 16rpx; padding: 22rpx 22rpx 42rpx; box-sizing: border-box; position: relative; }
.description-box textarea { width: 100%; height: 100%; font-size: 27rpx; line-height: 1.55; }
.counter { position: absolute; right: 20rpx; bottom: 14rpx; color: #8592a8; font-size: 24rpx; }
.evidence-head { margin-top: 38rpx; }
.field-hint { color: #8592a8; font-size: 25rpx; }
.image-grid { display: flex; gap: 18rpx; margin-top: 18rpx; }
.image-item { width: calc((100% - 36rpx) / 3); height: 188rpx; border-radius: 14rpx; overflow: hidden; position: relative; box-sizing: border-box; }
.preview-image { width: 100%; height: 100%; }
.image-delete { position: absolute; right: 8rpx; top: 8rpx; width: 38rpx; height: 38rpx; border-radius: 50%; background: rgba(0,0,0,.55); }
.image-add, .image-placeholder { border: 2rpx dashed #d6dee9; background: #fafcff; }
.image-add { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #738199; font-size: 24rpx; }
.image-add image { width: 58rpx; height: 58rpx; margin-bottom: 14rpx; }
.scroll-spacer { height: 44rpx; }
.submit-area { flex-shrink: 0; padding: 12rpx 36rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -8rpx 24rpx rgba(28, 55, 90, .04); }
.privacy-note { text-align: center; color: #8592a8; font-size: 24rpx; margin-bottom: 14rpx; }
.submit-button { height: 88rpx; line-height: 88rpx; border: 0; border-radius: 44rpx; background: #2783ee; color: #fff; font-size: 31rpx; font-weight: 600; padding: 0; }
.submit-button::after { border: 0; }
.submit-button.disabled { background: #a9cef8; color: #fff; }
